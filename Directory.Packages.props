    <PackageVersion Include="Incursa.Qlog.Quic" Version="1.1.3" />
    <PackageVersion Include="Microsoft.CodeAnalysis.PublicApiAnalyzers" Version="4.14.0" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.3.0" />
