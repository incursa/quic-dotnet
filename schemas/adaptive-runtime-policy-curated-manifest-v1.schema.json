{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://incursa.dev/schemas/adaptive-runtime-policy-curated-manifest-v1.schema.json",
  "title": "Adaptive Runtime Policy Curated Manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "curatedManifestId",
    "createdUtc",
    "normalizedDataset",
    "transformation",
    "curationPolicy",
    "rowDecisions",
    "summary"
  ],
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "adaptive-runtime-policy-curated-manifest-v1"
    },
    "curatedManifestId": {
      "type": "string",
      "minLength": 1
    },
    "createdUtc": {
      "type": "string",
      "format": "date-time"
    },
    "normalizedDataset": {
      "$ref": "#/$defs/datasetReference"
    },
    "transformation": {
      "$ref": "#/$defs/transformation"
    },
    "curationPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "appendOnly",
        "includedClassifications",
        "excludedClassifications",
        "excludedAnalysisFlags"
      ],
      "properties": {
        "appendOnly": {
          "type": "boolean",
          "const": true
        },
        "includedClassifications": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": [
              "accepted_local",
              "neutral_local",
              "negative_retained"
            ]
          }
        },
        "excludedClassifications": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": [
              "invalid_environment",
              "invalid_contract",
              "failed_correctness",
              "stress_only"
            ]
          }
        },
        "excludedAnalysisFlags": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": [
              "correctness_failed",
              "requested_effective_mismatch",
              "binary_identity_missing",
              "binary_changed",
              "target_health_invalid",
              "generator_health_invalid",
              "observation_missing",
              "observation_stale",
              "observation_saturated",
              "out_of_domain",
              "instrumentation_mismatch",
              "warmup",
              "cooldown",
              "terminal_partial_epoch",
              "policy_mismatch",
              "source_join_failed"
            ]
          }
        }
      }
    },
    "rowDecisions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/rowDecision"
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "includedRowCount",
        "excludedRowCount",
        "retainedNegativeRowCount"
      ],
      "properties": {
        "includedRowCount": {
          "type": "integer",
          "minimum": 0
        },
        "excludedRowCount": {
          "type": "integer",
          "minimum": 0
        },
        "retainedNegativeRowCount": {
          "type": "integer",
          "minimum": 0
        }
      }
    }
  },
  "$defs": {
    "nonEmptyString": {
      "type": "string",
      "minLength": 1
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{64}$"
    },
    "datasetReference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256",
        "normalizedDatasetId"
      ],
      "properties": {
        "path": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "normalizedDatasetId": {
          "$ref": "#/$defs/nonEmptyString"
        }
      }
    },
    "transformation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "version",
        "codeCommit"
      ],
      "properties": {
        "name": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "version": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "codeCommit": {
          "type": "string",
          "pattern": "^[0-9a-fA-F]{7,40}$"
        }
      }
    },
    "decisionReason": {
      "type": "string",
      "enum": [
        "none",
        "analysis_exclusion_flag",
        "invalid_environment_classification",
        "invalid_contract_classification",
        "failed_correctness_classification",
        "stress_only_classification",
        "retained_negative_evidence"
      ]
    },
    "rowDecision": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "rowId",
        "decision",
        "reasonCodes",
        "counterfactualGroupKey",
        "holdoutGroupKey",
        "labelSet"
      ],
      "properties": {
        "rowId": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "decision": {
          "type": "string",
          "enum": [
            "included",
            "excluded"
          ]
        },
        "reasonCodes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/decisionReason"
          }
        },
        "counterfactualGroupKey": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "holdoutGroupKey": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "labelSet": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "classification",
            "qualityBucket",
            "outcomeTier"
          ],
          "properties": {
            "classification": {
              "type": "string",
              "enum": [
                "accepted_local",
                "neutral_local",
                "negative_retained",
                "invalid_environment",
                "invalid_contract",
                "failed_correctness",
                "stress_only"
              ]
            },
            "qualityBucket": {
              "type": "string",
              "enum": [
                "eligible_measurement",
                "retained_negative",
                "excluded"
              ]
            },
            "outcomeTier": {
              "type": "string",
              "enum": [
                "counterfactual_candidate",
                "retained_negative",
                "excluded"
              ]
            }
          }
        }
      }
    }
  }
}
