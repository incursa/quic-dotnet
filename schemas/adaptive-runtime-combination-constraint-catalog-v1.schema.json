{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://incursa.dev/schemas/adaptive-runtime-combination-constraint-catalog-v1.schema.json",
  "title": "Adaptive Runtime Combination Constraint Catalog v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "document_id",
    "document_version",
    "content_sha256",
    "trace_references",
    "active_behavior_authorization",
    "performance_acceptance_authorization",
    "combination_constraints"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "adaptive-runtime-combination-constraint-catalog-v1"
    },
    "document_id": { "type": "string", "minLength": 1 },
    "document_version": { "type": "integer", "const": 1 },
    "content_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "trace_references": {
      "type": "object",
      "additionalProperties": false,
      "required": ["requirement_ids", "architecture_ids", "work_item_ids", "verification_ids"],
      "properties": {
        "requirement_ids": {
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": [
              "REQ-QUIC-CRT-0198",
              "REQ-QUIC-CRT-0199",
              "REQ-QUIC-CRT-0200",
              "REQ-QUIC-CRT-0201"
            ]
          }
        },
        "architecture_ids": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "const": "ARC-QUIC-CRT-0089" }
        },
        "work_item_ids": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "const": "WI-QUIC-CRT-0090" }
        },
        "verification_ids": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "const": "VER-QUIC-CRT-0091" }
        }
      }
    },
    "active_behavior_authorization": { "type": "boolean", "const": false },
    "performance_acceptance_authorization": { "type": "boolean", "const": false },
    "combination_constraints": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/combinationConstraint" }
    }
  },
  "$defs": {
    "experimentType": {
      "type": "string",
      "enum": [
        "actuation_validation",
        "isolated_counterfactual",
        "interaction_screen",
        "feedback_loop",
        "profile_validation"
      ]
    },
    "constraintState": {
      "type": "string",
      "enum": ["legal", "eligible", "blocked", "deferred", "capability_blocked"]
    },
    "equivalenceState": {
      "type": "string",
      "enum": ["equivalent", "verification_only", "not_equivalent"]
    },
    "combinationConstraint": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "constraint_id",
        "family_id",
        "experiment_types",
        "fixed_axis_ids",
        "varied_axis_ids",
        "predicate_refs",
        "guard_refs",
        "legality",
        "capability_state",
        "equivalence_state",
        "measurement_authorized",
        "promotion_deferred",
        "notes"
      ],
      "properties": {
        "constraint_id": { "type": "string", "minLength": 1 },
        "family_id": { "type": "string", "minLength": 1 },
        "experiment_types": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/experimentType" }
        },
        "fixed_axis_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": [
              "application_send_batch_formation",
              "buffer_copy_coalescing",
              "application_send_turn_planning"
            ]
          }
        },
        "varied_axis_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": [
              "application_send_batch_formation",
              "buffer_copy_coalescing",
              "application_send_turn_planning"
            ]
          }
        },
        "predicate_refs": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "guard_refs": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "legality": { "$ref": "#/$defs/constraintState" },
        "capability_state": { "$ref": "#/$defs/constraintState" },
        "equivalence_state": { "$ref": "#/$defs/equivalenceState" },
        "measurement_authorized": { "type": "boolean", "const": false },
        "promotion_deferred": { "type": "boolean", "const": true },
        "notes": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    }
  }
}
