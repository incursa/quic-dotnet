{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://incursa.dev/schemas/adaptive-runtime-buffer-copy-raw-v4.schema.json",
  "title": "Adaptive Runtime Buffer Copy Raw Record v4",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "connectionKey",
    "observation"
  ],
  "properties": {
    "schemaVersion": {
      "const": "quic-buffer-copy-raw-v4"
    },
    "connectionKey": {
      "type": "string",
      "minLength": 1
    },
    "observation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "operationSequence",
        "mode",
        "path",
        "operation",
        "decisionBoundary",
        "joinOperationSequence",
        "legalLogicalBytes",
        "logicalBytes",
        "copiedBytes",
        "legalSourceSegmentCount",
        "sourceSegmentCount",
        "destinationSegmentCount",
        "requestedCapacityBytes",
        "retainedCapacityBytes",
        "coalescingEvidence",
        "forcedValue",
        "shadowRecommendation",
        "selectedValue",
        "appliedValue",
        "selectionSource",
        "reasonCode",
        "safetyOverride",
        "latchLifetime",
        "fallbackApplied",
        "phaseAfter",
        "disposalStarted",
        "validity",
        "policyAxisId",
        "observationContractVersion",
        "ruleVersion",
        "snapshotVersion",
        "reasonVersion",
        "provenanceVersion"
      ],
      "properties": {
        "operationSequence": { "type": "integer", "minimum": 1 },
        "mode": {
          "enum": ["Disabled", "ObserveOnly", "Shadow"]
        },
        "path": {
          "enum": [
            "ApplicationWriteRequest",
            "OversizedRawQueue",
            "FormattedStreamPayload",
            "CombinedApplicationSend",
            "SentPacketPlaintextRetention",
            "RetransmissionClone",
            "ReceiveSegment",
            "OutboundPacketProtection"
          ]
        },
        "operation": {
          "enum": [
            "Copy",
            "ReuseAndCopy",
            "Format",
            "Combine",
            "Retain",
            "Clone",
            "Protect"
          ]
        },
        "decisionBoundary": {
          "enum": [
            "StreamWriteRetry",
            "LogicalWriteAdmission",
            "PacketPlan",
            "SentPacketRetention",
            "RetransmissionClone",
            "ReceiveSegmentInsertion",
            "PacketProtection"
          ]
        },
        "joinOperationSequence": {
          "type": ["integer", "null"]
        },
        "legalLogicalBytes": {
          "type": "integer",
          "minimum": 0
        },
        "logicalBytes": {
          "type": "integer",
          "minimum": 0
        },
        "copiedBytes": {
          "type": "integer",
          "minimum": 0
        },
        "legalSourceSegmentCount": {
          "type": "integer",
          "minimum": 0
        },
        "sourceSegmentCount": {
          "type": "integer",
          "minimum": 0
        },
        "destinationSegmentCount": {
          "type": "integer",
          "minimum": 0
        },
        "requestedCapacityBytes": {
          "type": "integer",
          "minimum": 0
        },
        "retainedCapacityBytes": {
          "type": "integer",
          "minimum": 0
        },
        "coalescingEvidence": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "epochSequence",
            "decisionInstanceSequence",
            "operationSequence",
            "candidateValue",
            "eligibilityResult",
            "eligibilityReason",
            "mechanismEvent",
            "legalSourceSegmentCount",
            "appliedSourceSegmentCount",
            "legalBytes",
            "appliedBytes",
            "ownerRented"
          ],
          "properties": {
            "epochSequence": { "type": "integer", "minimum": 0 },
            "decisionInstanceSequence": { "type": "integer", "minimum": 0 },
            "operationSequence": { "type": "integer", "minimum": 0 },
            "candidateValue": {
              "enum": ["LegacyCurrent", "MemoryConservative"]
            },
            "eligibilityResult": {
              "enum": ["Eligible", "Ineligible", "Clamped"]
            },
            "eligibilityReason": {
              "enum": [
                "Eligible",
                "StructurallyInactive",
                "MissingInput",
                "InvalidInput",
                "LifecycleGuard",
                "ResourceGuard",
                "SafetyOverride",
                "NotAxisMechanism",
                "UnclassifiableEvidence"
              ]
            },
            "mechanismEvent": {
              "enum": [
                "ExactCombinedPrefixRetained",
                "LowerTwoSourceSegmentCapApplied",
                "NoCombinedOwnerRented",
                "NotAxisMechanism",
                "Unclassifiable"
              ]
            },
            "legalSourceSegmentCount": {
              "type": "integer",
              "minimum": 0
            },
            "appliedSourceSegmentCount": {
              "type": "integer",
              "minimum": 0
            },
            "legalBytes": { "type": "integer", "minimum": 0 },
            "appliedBytes": { "type": "integer", "minimum": 0 },
            "ownerRented": { "type": "boolean" }
          }
        },
        "forcedValue": {
          "type": ["string", "null"],
          "enum": ["LegacyCurrent", "MemoryConservative", null]
        },
        "shadowRecommendation": {
          "type": ["string", "null"],
          "enum": ["LegacyCurrent", "MemoryConservative", null]
        },
        "selectedValue": {
          "enum": ["LegacyCurrent", "MemoryConservative"]
        },
        "appliedValue": {
          "enum": ["LegacyCurrent", "MemoryConservative"]
        },
        "selectionSource": {
          "enum": ["LegacyCurrent", "Forced", "ShadowRule", "SafetyOverride"]
        },
        "reasonCode": {
          "enum": [
            "LegacyCopy",
            "ExistingCapacityReused",
            "ObserveOnly",
            "Forced",
            "ShadowMemoryConservative",
            "MissingInput",
            "StaleInput",
            "ArithmeticSaturated",
            "Contradictory",
            "OutOfDomain",
            "InvalidInput",
            "LifecycleGuard",
            "NotApplicable"
          ]
        },
        "safetyOverride": {
          "enum": ["None", "InvalidObservation", "Lifecycle"]
        },
        "latchLifetime": { "const": "BufferLifetime" },
        "fallbackApplied": { "type": "boolean" },
        "phaseAfter": {
          "enum": [
            "Establishing",
            "Active",
            "Closing",
            "Draining",
            "Discarded"
          ]
        },
        "disposalStarted": { "type": "boolean" },
        "validity": { "type": ["string", "integer"] },
        "policyAxisId": { "const": "buffer_copy_coalescing" },
        "observationContractVersion": {
          "const": "quic-buffer-copy-observation-v4"
        },
        "ruleVersion": {
          "const": "quic-buffer-copy-memory-conservative-rule-v1"
        },
        "snapshotVersion": {
          "const": "quic-buffer-copy-policy-snapshot-v1"
        },
        "reasonVersion": {
          "const": "quic-buffer-copy-reason-v2"
        },
        "provenanceVersion": {
          "const": "quic-buffer-copy-provenance-v4"
        },
        "coalescingEvidence": { "type": "object" }
      }
    }
  }
}
