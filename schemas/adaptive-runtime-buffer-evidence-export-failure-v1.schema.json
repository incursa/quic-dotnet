{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://incursa.dev/schemas/adaptive-runtime-buffer-evidence-export-failure-v1.schema.json",
  "title": "Adaptive Runtime Buffer Evidence Export Failure v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "connectionKey",
    "evidenceKind",
    "operationSequence",
    "releaseSequence"
  ],
  "properties": {
    "schemaVersion": {
      "const": "quic-buffer-evidence-export-failure-v1"
    },
    "connectionKey": {
      "type": "string",
      "minLength": 1
    },
    "evidenceKind": {
      "enum": ["copy", "release"]
    },
    "operationSequence": {
      "type": "integer",
      "minimum": 1
    },
    "releaseSequence": {
      "type": ["integer", "null"],
      "minimum": 1
    }
  }
}
