{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://incursa.dev/schemas/adaptive-runtime-compiled-execution-manifest-v1.schema.json",
  "title": "Adaptive Runtime Compiled Execution Manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "document_id",
    "document_version",
    "content_sha256",
    "trace_references",
    "active_behavior_authorization",
    "performance_acceptance_authorization",
    "compiled_execution_manifest_id",
    "source_plan_ref",
    "source_validation_ref",
    "source_commit",
    "binary_provenance",
    "host_capabilities",
    "execution_order",
    "executable_cells",
    "post_build_refs",
    "build_status"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "adaptive-runtime-compiled-execution-manifest-v1"
    },
    "document_id": { "type": "string", "minLength": 1 },
    "document_version": { "type": "integer", "const": 1 },
    "content_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "trace_references": {
      "type": "object",
      "additionalProperties": false,
      "required": ["requirement_ids", "architecture_ids", "work_item_ids", "verification_ids"],
      "properties": {
        "requirement_ids": {
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": [
              "REQ-QUIC-CRT-0198",
              "REQ-QUIC-CRT-0199",
              "REQ-QUIC-CRT-0200",
              "REQ-QUIC-CRT-0201"
            ]
          }
        },
        "architecture_ids": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "const": "ARC-QUIC-CRT-0089" }
        },
        "work_item_ids": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "const": "WI-QUIC-CRT-0090" }
        },
        "verification_ids": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "const": "VER-QUIC-CRT-0091" }
        }
      }
    },
    "active_behavior_authorization": { "type": "boolean", "const": false },
    "performance_acceptance_authorization": { "type": "boolean", "const": false },
    "compiled_execution_manifest_id": { "type": "string", "minLength": 1 },
    "source_plan_ref": { "$ref": "#/$defs/documentRef" },
    "source_validation_ref": { "$ref": "#/$defs/documentRef" },
    "source_commit": {
      "type": "string",
      "pattern": "^[0-9a-f]{7,40}$"
    },
    "binary_provenance": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/binaryRef" }
    },
    "host_capabilities": { "$ref": "#/$defs/hostCapabilities" },
    "execution_order": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "executable_cells": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/executableCell" }
    },
    "post_build_refs": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/documentRef" }
    },
    "build_status": {
      "type": "string",
      "enum": ["compiled", "blocked_by_capability", "deferred"]
    },
    "notes": {
      "type": "array",
      "items": { "type": "string" }
    }
  },
  "$defs": {
    "documentRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["document_id", "schema_version", "document_version", "content_sha256"],
      "properties": {
        "document_id": { "type": "string", "minLength": 1 },
        "schema_version": { "type": "string", "minLength": 1 },
        "document_version": { "type": "integer", "minimum": 1 },
        "content_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      }
    },
    "binaryRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["role", "path", "content_sha256"],
      "properties": {
        "role": {
          "type": "string",
          "enum": [
            "source_plan",
            "validation_result",
            "runtime_binary",
            "test_binary",
            "other"
          ]
        },
        "path": { "type": "string", "minLength": 1 },
        "content_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      }
    },
    "hostCapabilities": {
      "type": "object",
      "additionalProperties": false,
      "required": ["host_id", "os", "architecture", "processor_count", "capability_flags"],
      "properties": {
        "host_id": { "type": "string", "minLength": 1 },
        "os": { "type": "string", "minLength": 1 },
        "architecture": { "type": "string", "minLength": 1 },
        "processor_count": { "type": "integer", "minimum": 1 },
        "capability_flags": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": [
              "source_plan_valid",
              "current_combination_blocked",
              "single_axis_executable",
              "multi_axis_blocked",
              "post_build_refs_present"
            ]
          }
        }
      }
    },
    "executableCell": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "cell_id",
        "cell_order",
        "axis_ids",
        "treatment_ids",
        "execution_state"
      ],
      "properties": {
        "cell_id": { "type": "string", "minLength": 1 },
        "cell_order": { "type": "integer", "minimum": 0 },
        "axis_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": [
              "application_send_batch_formation",
              "buffer_copy_coalescing",
              "application_send_turn_planning"
            ]
          }
        },
        "treatment_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "execution_state": {
          "type": "string",
          "enum": ["executable", "blocked", "deferred"]
        },
        "notes": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    }
  }
}
