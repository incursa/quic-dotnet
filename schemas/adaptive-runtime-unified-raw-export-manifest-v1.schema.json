{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://incursa.dev/schemas/adaptive-runtime-unified-raw-export-manifest-v1.schema.json",
  "title": "Adaptive Runtime Unified Raw Export Manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "createdUtc",
    "rawEpochSchemaVersion",
    "classification",
    "rowCount",
    "axisRecordCount",
    "connectionCount",
    "actorObservationRowCount",
    "bufferObservationRowCount",
    "exportFailureCount",
    "sources",
    "artifacts"
  ],
  "properties": {
    "schemaVersion": {
      "const": "adaptive-runtime-unified-raw-export-manifest-v1"
    },
    "createdUtc": {
      "type": "string",
      "format": "date-time"
    },
    "rawEpochSchemaVersion": {
      "const": "adaptive-runtime-unified-epoch-raw-v1"
    },
    "classification": {
      "enum": [
        "accepted",
        "invalid_contract"
      ]
    },
    "rowCount": {
      "type": "integer",
      "minimum": 1
    },
    "axisRecordCount": {
      "type": "integer",
      "minimum": 4
    },
    "connectionCount": {
      "type": "integer",
      "minimum": 1
    },
    "actorObservationRowCount": {
      "type": "integer",
      "minimum": 0
    },
    "bufferObservationRowCount": {
      "type": "integer",
      "minimum": 0
    },
    "exportFailureCount": {
      "type": "integer",
      "minimum": 0
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/source"
      }
    },
    "artifacts": {
      "type": "array",
      "minItems": 2,
      "items": {
        "$ref": "#/$defs/artifact"
      }
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256",
        "rowCount",
        "exportFailureCount"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "rowCount": {
          "type": "integer",
          "minimum": 0
        },
        "exportFailureCount": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "role",
        "path",
        "sha256",
        "bytes"
      ],
      "properties": {
        "role": {
          "enum": [
            "raw_epochs",
            "validation_summary",
            "export_failures"
          ]
        },
        "path": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "bytes": {
          "type": "integer",
          "minimum": 1
        }
      }
    }
  }
}
