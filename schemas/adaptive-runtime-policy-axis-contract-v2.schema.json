{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://incursa.dev/schemas/adaptive-runtime-policy-axis-contract-v2.schema.json",
  "title": "Adaptive Runtime Policy Axis Contract v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "document_id",
    "document_version",
    "content_sha256",
    "trace_references",
    "active_behavior_authorization",
    "performance_acceptance_authorization",
    "axis_contracts"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "adaptive-runtime-policy-axis-contract-v2"
    },
    "document_id": { "type": "string", "minLength": 1 },
    "document_version": { "type": "integer", "const": 2 },
    "content_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "trace_references": {
      "type": "object",
      "additionalProperties": false,
      "required": ["requirement_ids", "architecture_ids", "work_item_ids", "verification_ids"],
      "properties": {
        "requirement_ids": {
          "type": "array",
          "minItems": 6,
          "maxItems": 6,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": [
              "REQ-QUIC-CRT-0235",
              "REQ-QUIC-CRT-0236",
              "REQ-QUIC-CRT-0237",
              "REQ-QUIC-CRT-0238", "REQ-QUIC-CRT-0239", "REQ-QUIC-CRT-0240"
            ]
          }
        },
        "architecture_ids": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "const": "ARC-QUIC-CRT-0113" }
        },
        "work_item_ids": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "const": "WI-QUIC-CRT-0114" }
        },
        "verification_ids": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "const": "VER-QUIC-CRT-0115" }
        }
      }
    },
    "active_behavior_authorization": { "type": "boolean", "const": false },
    "performance_acceptance_authorization": { "type": "boolean", "const": false },
    "axis_contracts": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/axisContract" }
    }
  },
  "$defs": {
    "axisId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:_[a-z0-9]+)*$"
    },
    "status": {
      "type": "string",
      "enum": ["implemented", "blocked", "preparation_only"]
    },
    "policyValue": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:_[a-z0-9]+)*$"
    },
    "documentRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["document_id", "schema_version", "document_version", "content_sha256"],
      "properties": {
        "document_id": { "type": "string", "minLength": 1 },
        "schema_version": { "type": "string", "minLength": 1 },
        "document_version": { "type": "integer", "minimum": 1 },
        "content_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      }
    },
    "selectionCompatibility": {
      "type": "object",
      "additionalProperties": false,
      "required": ["selected_value", "candidate_value", "compatible", "comparison_mode"],
      "properties": {
        "selected_value": { "$ref": "#/$defs/policyValue" },
        "candidate_value": { "type": "string", "minLength": 1 },
        "compatible": { "type": "boolean" },
        "comparison_mode": {
          "type": "string",
          "enum": ["applied", "verification_only", "blocked_by_capability"]
        },
        "reason": { "type": "string" }
      }
    },
    "predicate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["predicate_id", "description"],
      "properties": {
        "predicate_id": { "type": "string", "minLength": 1 },
        "description": { "type": "string", "minLength": 1 }
      }
    },
    "safetyClamp": {
      "type": "object",
      "additionalProperties": false,
      "required": ["clamp_id", "description"],
      "properties": {
        "clamp_id": { "type": "string", "minLength": 1 },
        "description": { "type": "string", "minLength": 1 }
      }
    },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": ["owner", "scope", "boundary", "latch"],
      "properties": {
        "owner": { "type": "string", "const": "connection_actor" },
        "scope": { "type": "string", "minLength": 1 },
        "boundary": { "type": "string", "minLength": 1 },
        "latch": { "type": "string", "minLength": 1 }
      }
    },
    "axisContract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "axis_id",
        "status",
        "executable",
        "policy_values",
        "authority",
        "scope",
        "boundary",
        "latch",
        "selected_value_compatibility",
        "canonical_predicates",
        "safety_clamps",
        "trace_references"
      ],
      "properties": {
        "axis_id": { "$ref": "#/$defs/axisId" },
        "status": { "$ref": "#/$defs/status" },
        "executable": { "type": "boolean" },
        "policy_values": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/policyValue" }
        },
        "authority": { "$ref": "#/$defs/authority" },
        "scope": { "type": "string", "minLength": 1 },
        "boundary": { "type": "string", "minLength": 1 },
        "latch": { "type": "string", "minLength": 1 },
        "selected_value_compatibility": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/selectionCompatibility" }
        },
        "canonical_predicates": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/predicate" }
        },
        "safety_clamps": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/safetyClamp" }
        },
        "readiness": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "forceable",
            "rollback_proof_status",
            "actuation_validation_status",
            "behavior_distinctness_status",
            "activation_predicate_refs",
            "behavior_distinctness_predicate_refs",
            "required_capability_ids"
          ],
          "properties": {
            "forceable": { "type": "boolean" },
            "rollback_proof_status": {
              "type": "string",
              "enum": ["represented", "missing", "not_applicable"]
            },
            "actuation_validation_status": {
              "type": "string",
              "enum": ["passed", "pending", "blocked", "not_applicable"]
            },
            "behavior_distinctness_status": {
              "type": "string",
              "enum": ["proven", "expected_equivalent", "unproven", "not_applicable"]
            },
            "activation_predicate_refs": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": { "type": "string", "minLength": 1 }
            },
            "behavior_distinctness_predicate_refs": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": { "type": "string", "minLength": 1 }
            },
            "required_capability_ids": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9]*(?:_[a-z0-9]+)*$"
              }
            }
          }
        },
        "compatibility_refs": {
          "type": "array",
          "items": { "$ref": "#/$defs/documentRef" }
        },
        "notes": {
          "type": "array",
          "items": { "type": "string" }
        },
        "trace_references": {
          "type": "object",
          "additionalProperties": false,
          "required": ["requirement_ids", "architecture_ids", "work_item_ids", "verification_ids"],
          "properties": {
            "requirement_ids": {
              "type": "array",
              "minItems": 6,
              "maxItems": 6,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "enum": [
                  "REQ-QUIC-CRT-0235",
                  "REQ-QUIC-CRT-0236",
                  "REQ-QUIC-CRT-0237",
                  "REQ-QUIC-CRT-0238", "REQ-QUIC-CRT-0239", "REQ-QUIC-CRT-0240"
                ]
              }
            },
            "architecture_ids": {
              "type": "array",
              "minItems": 1,
              "maxItems": 1,
              "uniqueItems": true,
              "items": { "type": "string", "const": "ARC-QUIC-CRT-0113" }
            },
            "work_item_ids": {
              "type": "array",
              "minItems": 1,
              "maxItems": 1,
              "uniqueItems": true,
              "items": { "type": "string", "const": "WI-QUIC-CRT-0114" }
            },
            "verification_ids": {
              "type": "array",
              "minItems": 1,
              "maxItems": 1,
              "uniqueItems": true,
              "items": { "type": "string", "const": "VER-QUIC-CRT-0115" }
            }
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "status": { "enum": ["blocked", "preparation_only"] }
            },
            "required": ["status"]
          },
          "then": {
            "properties": {
              "executable": { "const": false }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": { "const": "implemented" }
            },
            "required": ["status"]
          },
          "then": {
            "properties": {
              "executable": { "const": true }
            }
          }
        }
      ]
    }
  }
}
