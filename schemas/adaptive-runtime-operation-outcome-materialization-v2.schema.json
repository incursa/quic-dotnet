{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/incursa/quic-dotnet/schemas/adaptive-runtime-operation-outcome-materialization-v2.schema.json",
  "title": "Adaptive runtime operation outcome materialization v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "document_id",
    "document_version",
    "content_sha256",
    "source_evidence_ref",
    "behavior_catalog_ref",
    "classification_set_ref",
    "aggregates",
    "derivations",
    "retained_classifications",
    "active_behavior_authorization",
    "performance_acceptance_authorization",
    "trace_references"
  ],
  "properties": {
    "schema_version": { "const": "adaptive-runtime-operation-outcome-materialization-v2" },
    "document_id": { "$ref": "#/$defs/id" },
    "document_version": { "const": 2 },
    "content_sha256": { "$ref": "#/$defs/hash" },
    "source_evidence_ref": { "$ref": "#/$defs/documentRef" },
    "behavior_catalog_ref": { "$ref": "#/$defs/documentRef" },
    "classification_set_ref": { "$ref": "#/$defs/documentRef" },
    "aggregates": { "type": "array", "items": { "$ref": "#/$defs/aggregate" } },
    "derivations": { "type": "array", "items": { "$ref": "#/$defs/derivation" } },
    "retained_classifications": { "type": "array", "items": { "type": "object" } },
    "active_behavior_authorization": { "const": false },
    "performance_acceptance_authorization": { "const": false },
    "trace_references": { "$ref": "#/$defs/traceReferences" }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._:-]*$" },
    "hash": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "positiveInteger": { "type": "integer", "minimum": 1 },
    "nonNegativeInteger": { "type": "integer", "minimum": 0 },
    "nullableId": { "oneOf": [{ "$ref": "#/$defs/id" }, { "type": "null" }] },
    "nullableBoolean": { "oneOf": [{ "type": "boolean" }, { "type": "null" }] },
    "documentRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["document_id", "schema_version", "document_version", "content_sha256"],
      "properties": {
        "document_id": { "$ref": "#/$defs/id" },
        "schema_version": { "$ref": "#/$defs/id" },
        "document_version": { "$ref": "#/$defs/positiveInteger" },
        "content_sha256": { "$ref": "#/$defs/hash" }
      }
    },
    "operationIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["identity_version", "operation_key", "run_id", "connection_key", "epoch_sequence", "axis_id", "decision_instance_id", "operation_id"],
      "properties": {
        "identity_version": { "const": 1 },
        "operation_key": { "type": "string", "pattern": "^operation_identity_v1:[0-9a-f]{64}$" },
        "run_id": { "$ref": "#/$defs/id" },
        "connection_key": { "$ref": "#/$defs/id" },
        "epoch_sequence": { "$ref": "#/$defs/positiveInteger" },
        "axis_id": { "$ref": "#/$defs/id" },
        "decision_instance_id": { "$ref": "#/$defs/positiveInteger" },
        "operation_id": { "$ref": "#/$defs/positiveInteger" }
      }
    },
    "aggregate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["run_id", "connection_key", "epoch_sequence", "axis_id", "outcome_contract_version", "outcome_id", "operation_count", "work_count", "byte_count", "source_operation_identities"],
      "properties": {
        "run_id": { "$ref": "#/$defs/id" },
        "connection_key": { "$ref": "#/$defs/id" },
        "epoch_sequence": { "$ref": "#/$defs/positiveInteger" },
        "axis_id": { "$ref": "#/$defs/id" },
        "outcome_contract_version": { "const": 2 },
        "outcome_id": { "$ref": "#/$defs/id" },
        "operation_count": { "$ref": "#/$defs/positiveInteger" },
        "work_count": { "$ref": "#/$defs/nonNegativeInteger" },
        "byte_count": { "$ref": "#/$defs/nonNegativeInteger" },
        "source_operation_identities": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/operationIdentity" } }
      }
    },
    "derivation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["operation_identity", "result_kind", "derivation_status", "outcome_id", "requires_retained_classification", "error_code"],
      "properties": {
        "operation_identity": { "$ref": "#/$defs/operationIdentity" },
        "result_kind": { "$ref": "#/$defs/id" },
        "derivation_status": { "enum": ["matched", "behavior_only", "no_match", "ambiguous"] },
        "outcome_id": { "$ref": "#/$defs/nullableId" },
        "requires_retained_classification": { "$ref": "#/$defs/nullableBoolean" },
        "error_code": { "$ref": "#/$defs/nullableId" }
      }
    },
    "traceReferences": {
      "type": "object",
      "additionalProperties": false,
      "required": ["requirement_ids", "architecture_ids", "work_item_ids", "verification_ids"],
      "properties": {
        "requirement_ids": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "architecture_ids": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "work_item_ids": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "verification_ids": { "type": "array", "minItems": 1, "items": { "type": "string" } }
      }
    }
  }
}
