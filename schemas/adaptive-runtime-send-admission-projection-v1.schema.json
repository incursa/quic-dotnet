{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/incursa/quic-dotnet/schemas/adaptive-runtime-send-admission-projection-v1.schema.json",
  "title": "Adaptive runtime send-admission correctness projection v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "document_id",
    "document_version",
    "content_sha256",
    "cell_id",
    "source_refs",
    "operation_count",
    "release_count",
    "configured_values",
    "applied_values",
    "mechanism_event_ids",
    "behavior_materialization_sha256",
    "outcome_materialization_sha256",
    "performance_metric_count",
    "active_behavior_authorization",
    "performance_acceptance_authorization",
    "trace_references"
  ],
  "properties": {
    "schema_version": { "const": "adaptive-runtime-send-admission-projection-v1" },
    "document_id": { "$ref": "#/$defs/id" },
    "document_version": { "const": 1 },
    "content_sha256": { "$ref": "#/$defs/hash" },
    "cell_id": { "$ref": "#/$defs/id" },
    "source_refs": {
      "type": "array",
      "minItems": 16,
      "maxItems": 16,
      "items": { "$ref": "#/$defs/documentRef" }
    },
    "operation_count": { "const": 3 },
    "release_count": { "const": 1 },
    "configured_values": { "$ref": "#/$defs/axisValues" },
    "applied_values": { "$ref": "#/$defs/axisValues" },
    "mechanism_event_ids": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": { "$ref": "#/$defs/id" }
    },
    "behavior_materialization_sha256": { "$ref": "#/$defs/hash" },
    "outcome_materialization_sha256": { "$ref": "#/$defs/hash" },
    "performance_metric_count": { "const": 0 },
    "active_behavior_authorization": { "const": false },
    "performance_acceptance_authorization": { "const": false },
    "trace_references": { "$ref": "#/$defs/traceReferences" }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$" },
    "hash": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "documentRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["document_id", "schema_version", "document_version", "content_sha256"],
      "properties": {
        "document_id": { "$ref": "#/$defs/id" },
        "schema_version": { "$ref": "#/$defs/id" },
        "document_version": { "type": "integer", "minimum": 1 },
        "content_sha256": { "$ref": "#/$defs/hash" }
      }
    },
    "axisValues": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "oversized_write_admission_quantum",
        "application_send_batch_formation",
        "buffer_copy_coalescing"
      ],
      "properties": {
        "oversized_write_admission_quantum": { "enum": ["legacy_current", "single_fragment"] },
        "application_send_batch_formation": { "enum": ["legacy_current", "single_eligible"] },
        "buffer_copy_coalescing": { "enum": ["legacy_current", "memory_conservative"] }
      }
    },
    "traceReferences": {
      "type": "object",
      "additionalProperties": false,
      "required": ["requirement_ids", "architecture_ids", "work_item_ids", "verification_ids"],
      "properties": {
        "requirement_ids": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "architecture_ids": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "work_item_ids": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "verification_ids": { "type": "array", "minItems": 1, "items": { "type": "string" } }
      }
    }
  }
}
