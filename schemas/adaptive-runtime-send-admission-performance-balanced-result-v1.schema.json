{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://incursa.dev/schemas/adaptive-runtime-send-admission-performance-balanced-result-v1.schema.json",
  "title": "Adaptive Runtime Send Admission Performance Balanced Result v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "document_id",
    "document_version",
    "content_sha256",
    "control_ref",
    "compiled_manifest_ref",
    "source_commit",
    "source_dirty_state",
    "controller_uri",
    "worker_pair",
    "workload",
    "run_counts",
    "packages",
    "failed_attempts",
    "runs",
    "cells",
    "block_summaries",
    "position_summaries",
    "factorial_contrasts",
    "resource_telemetry",
    "analysis_boundary",
    "covering_array",
    "limitations",
    "conclusion",
    "performance_acceptance_authorization",
    "adaptive_rule_derivation_authorization",
    "active_behavior_authorization",
    "production_activation_authorization",
    "trace_references"
  ],
  "properties": {
    "schema_version": { "const": "adaptive-runtime-send-admission-performance-balanced-result-v1" },
    "document_id": { "const": "adaptive_runtime_send_admission_performance_balanced_result_v1" },
    "document_version": { "const": 1 },
    "content_sha256": { "$ref": "#/$defs/hash" },
    "control_ref": { "$ref": "#/$defs/documentRef" },
    "compiled_manifest_ref": { "$ref": "#/$defs/documentRef" },
    "source_commit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "source_dirty_state": { "const": "clean" },
    "controller_uri": { "const": "http://10.10.99.176:5088" },
    "worker_pair": {
      "type": "object",
      "additionalProperties": false,
      "required": ["topology_classification", "evidence_tier", "identity_caveat", "sut_node_id", "sut_physical_host_id", "load_node_id", "load_physical_host_id"],
      "properties": {
        "topology_classification": { "const": "independent_physical_hosts" },
        "evidence_tier": { "const": "offline-ml-two-host-vm" },
        "identity_caveat": { "type": "string", "minLength": 1 },
        "sut_node_id": { "const": "plab-worker-x64-02" },
        "sut_physical_host_id": { "const": "plab-worker-x64-02" },
        "load_node_id": { "const": "plab-worker-x64-03" },
        "load_physical_host_id": { "const": "plab-worker-x64-03" }
      }
    },
    "workload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["suite_id", "scenario_id", "protocol", "test_executor_id", "load_profile_id", "repetitions_per_cell", "block_count"],
      "properties": {
        "suite_id": { "const": "quic-transport-v1-comparison" },
        "scenario_id": { "const": "quic.transport.multiplex.100x64kb" },
        "protocol": { "const": "quic" },
        "test_executor_id": { "const": "quic-go-raw-load" },
        "load_profile_id": { "const": "raw-quic-peer-confidence" },
        "repetitions_per_cell": { "const": 8 },
        "block_count": { "const": 8 }
      }
    },
    "run_counts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["planned_runs", "completed_runs", "actual_measurements_run", "failed_attempts", "failed_requests", "timeout_requests", "saturated_runs"],
      "properties": {
        "planned_runs": { "const": 64 },
        "completed_runs": { "const": 64 },
        "actual_measurements_run": { "const": 64 },
        "failed_attempts": { "const": 2 },
        "failed_requests": { "const": 0 },
        "timeout_requests": { "const": 0 },
        "saturated_runs": { "const": 0 }
      }
    },
    "packages": {
      "type": "array",
      "minItems": 8,
      "maxItems": 8,
      "items": { "$ref": "#/$defs/cellPackage" }
    },
    "failed_attempts": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": { "$ref": "#/$defs/failedAttempt" }
    },
    "runs": {
      "type": "array",
      "minItems": 64,
      "maxItems": 64,
      "items": { "$ref": "#/$defs/run" }
    },
    "cells": {
      "type": "array",
      "minItems": 8,
      "maxItems": 8,
      "items": { "$ref": "#/$defs/cellSummary" }
    },
    "block_summaries": {
      "type": "array",
      "minItems": 8,
      "maxItems": 8,
      "items": { "$ref": "#/$defs/indexSummary" }
    },
    "position_summaries": {
      "type": "array",
      "minItems": 8,
      "maxItems": 8,
      "items": { "$ref": "#/$defs/indexSummary" }
    },
    "factorial_contrasts": {
      "type": "array",
      "minItems": 7,
      "maxItems": 7,
      "items": { "$ref": "#/$defs/contrast" }
    },
    "resource_telemetry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["load_process_samples_present", "load_process_warnings_retained", "target_runtime_counter_status", "load_cpu_percent", "load_cpu_peak_interval_max", "load_memory_max_bytes", "server_stdout_bytes", "bounded_server_stdout_max_bytes"],
      "properties": {
        "load_process_samples_present": { "const": true },
        "load_process_warnings_retained": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
        "target_runtime_counter_status": { "const": "unavailable" },
        "load_cpu_percent": { "$ref": "#/$defs/statistics" },
        "load_cpu_peak_interval_max": { "type": "number", "minimum": 0 },
        "load_memory_max_bytes": { "type": "integer", "minimum": 1 },
        "server_stdout_bytes": { "$ref": "#/$defs/statistics" },
        "bounded_server_stdout_max_bytes": { "const": 65536 }
      }
    },
    "analysis_boundary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["classification", "contrast_definition", "block_effect_definition", "predeclared_practical_thresholds_available", "threshold_consequence", "held_out_validation_available"],
      "properties": {
        "classification": { "const": "descriptive_characterization_only" },
        "contrast_definition": { "const": "mean_at_positive_coding_minus_mean_at_negative_coding" },
        "block_effect_definition": { "const": "same_contrast_recomputed_once_per_balanced_block" },
        "predeclared_practical_thresholds_available": { "const": false },
        "threshold_consequence": { "const": "blocks_performance_acceptance_and_rule_derivation" },
        "held_out_validation_available": { "const": false }
      }
    },
    "covering_array": {
      "type": "object",
      "additionalProperties": false,
      "required": ["generator_implemented", "required_for_current_eight_cell_family", "trigger_effective_cell_count"],
      "properties": {
        "generator_implemented": { "const": false },
        "required_for_current_eight_cell_family": { "const": false },
        "trigger_effective_cell_count": { "const": 65 }
      }
    },
    "limitations": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "conclusion": { "const": "balanced_campaign_completed_characterization_only_no_rule" },
    "performance_acceptance_authorization": { "const": false },
    "adaptive_rule_derivation_authorization": { "const": false },
    "active_behavior_authorization": { "const": false },
    "production_activation_authorization": { "const": false },
    "trace_references": { "$ref": "#/$defs/trace" }
  },
  "$defs": {
    "hash": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "cellId": { "type": "string", "enum": ["a0", "a1", "a2", "a3", "a4", "a5", "a6", "a7"] },
    "documentRef": {
      "type": "object", "additionalProperties": false,
      "required": ["document_id", "schema_version", "document_version", "content_sha256"],
      "properties": {
        "document_id": { "type": "string", "minLength": 1 },
        "schema_version": { "type": "string", "minLength": 1 },
        "document_version": { "type": "integer", "minimum": 1 },
        "content_sha256": { "$ref": "#/$defs/hash" }
      }
    },
    "packageRef": {
      "type": "object", "additionalProperties": false,
      "required": ["package_id", "package_version", "sha256"],
      "properties": {
        "package_id": { "const": "quic-dotnet-raw-dev" },
        "package_version": { "type": "string", "minLength": 1 },
        "sha256": { "$ref": "#/$defs/hash" }
      }
    },
    "cellPackage": {
      "type": "object", "additionalProperties": false,
      "required": ["cell_id", "package_ref"],
      "properties": { "cell_id": { "$ref": "#/$defs/cellId" }, "package_ref": { "$ref": "#/$defs/packageRef" } }
    },
    "failedAttempt": {
      "type": "object", "additionalProperties": false,
      "required": ["execution_index", "attempt_index", "cell_id", "job_id", "failure_reason_code", "measurement_recorded"],
      "properties": {
        "execution_index": { "type": "integer", "minimum": 1, "maximum": 64 },
        "attempt_index": { "type": "integer", "minimum": 1 },
        "cell_id": { "$ref": "#/$defs/cellId" },
        "job_id": { "type": "string", "pattern": "^job-[0-9a-f]{32}$" },
        "failure_reason_code": { "type": "string", "minLength": 1 },
        "measurement_recorded": { "const": false }
      }
    },
    "policyValues": {
      "type": "object", "additionalProperties": false,
      "required": ["oversized_write_admission_quantum", "application_send_batch_formation", "buffer_copy_coalescing"],
      "properties": {
        "oversized_write_admission_quantum": { "enum": ["legacy_current", "single_fragment"] },
        "application_send_batch_formation": { "enum": ["legacy_current", "single_eligible"] },
        "buffer_copy_coalescing": { "enum": ["legacy_current", "memory_conservative"] }
      }
    },
    "metrics": {
      "type": "object", "additionalProperties": false,
      "required": ["requests_per_second", "useful_bytes_per_second", "latency_p50_ms", "latency_p95_ms"],
      "properties": {
        "requests_per_second": { "type": "number", "exclusiveMinimum": 0 },
        "useful_bytes_per_second": { "type": "number", "exclusiveMinimum": 0 },
        "latency_p50_ms": { "type": "number", "minimum": 0 },
        "latency_p95_ms": { "type": "number", "minimum": 0 }
      }
    },
    "run": {
      "type": "object", "additionalProperties": false,
      "required": ["execution_index", "block_index", "position_index", "cell_id", "job_id", "run_id", "package_ref", "metrics", "total_requests", "successful_requests", "failed_requests", "timeout_requests", "bytes_sent", "bytes_received", "load_generator_saturation_status", "bounded_aggregate", "load_process", "target_runtime_counter_status"],
      "properties": {
        "execution_index": { "type": "integer", "minimum": 1, "maximum": 64 },
        "block_index": { "type": "integer", "minimum": 1, "maximum": 8 },
        "position_index": { "type": "integer", "minimum": 1, "maximum": 8 },
        "cell_id": { "$ref": "#/$defs/cellId" },
        "job_id": { "type": "string", "pattern": "^job-[0-9a-f]{32}$" },
        "run_id": { "type": "string", "minLength": 1 },
        "package_ref": { "$ref": "#/$defs/packageRef" },
        "metrics": { "$ref": "#/$defs/metrics" },
        "total_requests": { "type": "integer", "minimum": 1 },
        "successful_requests": { "type": "integer", "minimum": 1 },
        "failed_requests": { "const": 0 },
        "timeout_requests": { "const": 0 },
        "bytes_sent": { "type": "integer", "minimum": 1 },
        "bytes_received": { "type": "integer", "minimum": 1 },
        "load_generator_saturation_status": { "const": "load-generator-saturation-not-detected" },
        "bounded_aggregate": { "$ref": "#/$defs/activation" },
        "load_process": {
          "type": "object", "additionalProperties": false,
          "required": ["sample_count", "normalized_cpu_percent_mean", "normalized_cpu_percent_peak_interval", "memory_max_bytes", "warnings"],
          "properties": {
            "sample_count": { "type": "integer", "minimum": 1 },
            "normalized_cpu_percent_mean": { "type": "number", "minimum": 0 },
            "normalized_cpu_percent_peak_interval": { "type": "number", "minimum": 0 },
            "memory_max_bytes": { "type": "integer", "minimum": 1 },
            "warnings": { "type": "array", "items": { "type": "string", "minLength": 1 } }
          }
        },
        "target_runtime_counter_status": { "const": "unavailable" }
      }
    },
    "activation": {
      "type": "object", "additionalProperties": false,
      "required": ["epoch_count", "stdout_bytes", "application_send_batch_evidence_count", "application_send_batch_applied_write_count", "oversized_write_evidence_count", "oversized_committed_fragments", "oversized_committed_bytes", "buffer_copy_operation_count", "owner_release_count", "arithmetic_saturated"],
      "properties": {
        "epoch_count": { "type": "integer", "minimum": 1 },
        "stdout_bytes": { "type": "integer", "minimum": 1, "maximum": 65536 },
        "application_send_batch_evidence_count": { "type": "integer", "minimum": 1 },
        "application_send_batch_applied_write_count": { "type": "integer", "minimum": 1 },
        "oversized_write_evidence_count": { "type": "integer", "minimum": 1 },
        "oversized_committed_fragments": { "type": "integer", "minimum": 1 },
        "oversized_committed_bytes": { "type": "integer", "minimum": 1 },
        "buffer_copy_operation_count": { "type": "integer", "minimum": 1 },
        "owner_release_count": { "type": "integer", "minimum": 1 },
        "arithmetic_saturated": { "const": false }
      }
    },
    "statistics": {
      "type": "object", "additionalProperties": false,
      "required": ["n", "mean", "median", "sample_standard_deviation", "coefficient_of_variation_percent", "minimum", "maximum"],
      "properties": {
        "n": { "type": "integer", "minimum": 1 },
        "mean": { "type": "number" },
        "median": { "type": "number" },
        "sample_standard_deviation": { "type": "number", "minimum": 0 },
        "coefficient_of_variation_percent": { "type": "number", "minimum": 0 },
        "minimum": { "type": "number" },
        "maximum": { "type": "number" }
      }
    },
    "cellSummary": {
      "type": "object", "additionalProperties": false,
      "required": ["cell_id", "policy_values", "package_ref", "requests_per_second", "useful_bytes_per_second", "latency_p50_ms", "latency_p95_ms", "activation_totals"],
      "properties": {
        "cell_id": { "$ref": "#/$defs/cellId" },
        "policy_values": { "$ref": "#/$defs/policyValues" },
        "package_ref": { "$ref": "#/$defs/packageRef" },
        "requests_per_second": { "$ref": "#/$defs/statistics" },
        "useful_bytes_per_second": { "$ref": "#/$defs/statistics" },
        "latency_p50_ms": { "$ref": "#/$defs/statistics" },
        "latency_p95_ms": { "$ref": "#/$defs/statistics" },
        "activation_totals": { "$ref": "#/$defs/activationTotals" }
      }
    },
    "activationTotals": {
      "type": "object", "additionalProperties": false,
      "required": ["epoch_count", "stdout_bytes", "application_send_batch_evidence_count", "application_send_batch_applied_write_count", "oversized_write_evidence_count", "oversized_committed_fragments", "oversized_committed_bytes", "buffer_copy_operation_count", "owner_release_count", "arithmetic_saturated"],
      "properties": {
        "epoch_count": { "type": "integer", "minimum": 1 },
        "stdout_bytes": { "type": "integer", "minimum": 1 },
        "application_send_batch_evidence_count": { "type": "integer", "minimum": 1 },
        "application_send_batch_applied_write_count": { "type": "integer", "minimum": 1 },
        "oversized_write_evidence_count": { "type": "integer", "minimum": 1 },
        "oversized_committed_fragments": { "type": "integer", "minimum": 1 },
        "oversized_committed_bytes": { "type": "integer", "minimum": 1 },
        "buffer_copy_operation_count": { "type": "integer", "minimum": 1 },
        "owner_release_count": { "type": "integer", "minimum": 1 },
        "arithmetic_saturated": { "const": false }
      }
    },
    "indexSummary": {
      "type": "object", "additionalProperties": false,
      "required": ["index", "requests_per_second", "latency_p95_ms"],
      "properties": { "index": { "type": "integer", "minimum": 1, "maximum": 8 }, "requests_per_second": { "$ref": "#/$defs/statistics" }, "latency_p95_ms": { "$ref": "#/$defs/statistics" } }
    },
    "effect": {
      "type": "object", "additionalProperties": false,
      "required": ["metric_id", "grand_mean", "negative_mean", "positive_mean", "effect", "effect_percent_of_grand_mean", "block_effects"],
      "properties": {
        "metric_id": { "enum": ["requests_per_second", "useful_bytes_per_second", "latency_p50_ms", "latency_p95_ms"] },
        "grand_mean": { "type": "number" },
        "negative_mean": { "type": "number" },
        "positive_mean": { "type": "number" },
        "effect": { "type": "number" },
        "effect_percent_of_grand_mean": { "type": "number" },
        "block_effects": { "$ref": "#/$defs/statistics" }
      }
    },
    "contrast": {
      "type": "object", "additionalProperties": false,
      "required": ["term", "factors", "classification", "effects"],
      "properties": {
        "term": { "enum": ["oversized", "batch", "buffer", "oversized_x_batch", "oversized_x_buffer", "batch_x_buffer", "oversized_x_batch_x_buffer"] },
        "factors": { "type": "array", "minItems": 1, "maxItems": 3, "uniqueItems": true, "items": { "enum": ["oversized_write_admission_quantum", "application_send_batch_formation", "buffer_copy_coalescing"] } },
        "classification": { "const": "descriptive_characterization_only" },
        "effects": { "type": "array", "minItems": 4, "maxItems": 4, "items": { "$ref": "#/$defs/effect" } }
      }
    },
    "trace": {
      "type": "object", "additionalProperties": false,
      "required": ["requirement_ids", "architecture_ids", "work_item_ids", "verification_ids"],
      "properties": {
        "requirement_ids": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string" } },
        "architecture_ids": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string" } },
        "work_item_ids": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string" } },
        "verification_ids": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string" } }
      }
    }
  }
}
