{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://incursa.dev/schemas/adaptive-runtime-experiment-plan-v1.schema.json",
  "title": "Adaptive Runtime Experiment Plan v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "document_id",
    "document_version",
    "content_sha256",
    "trace_references",
    "active_behavior_authorization",
    "performance_acceptance_authorization",
    "experiment_plan_id",
    "family_id",
    "experiment_type",
    "fixed_axis_ids",
    "varied_axis_ids",
    "treatment_order",
    "treatments",
    "planned_cells",
    "execution_status"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "adaptive-runtime-experiment-plan-v1"
    },
    "document_id": { "type": "string", "minLength": 1 },
    "document_version": { "type": "integer", "const": 1 },
    "content_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "trace_references": {
      "type": "object",
      "additionalProperties": false,
      "required": ["requirement_ids", "architecture_ids", "work_item_ids", "verification_ids"],
      "properties": {
        "requirement_ids": {
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": [
              "REQ-QUIC-CRT-0198",
              "REQ-QUIC-CRT-0199",
              "REQ-QUIC-CRT-0200",
              "REQ-QUIC-CRT-0201"
            ]
          }
        },
        "architecture_ids": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "const": "ARC-QUIC-CRT-0089" }
        },
        "work_item_ids": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "const": "WI-QUIC-CRT-0090" }
        },
        "verification_ids": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "const": "VER-QUIC-CRT-0091" }
        }
      }
    },
    "active_behavior_authorization": { "type": "boolean", "const": false },
    "performance_acceptance_authorization": { "type": "boolean", "const": false },
    "experiment_plan_id": { "type": "string", "minLength": 1 },
    "family_id": { "type": "string", "minLength": 1 },
    "experiment_type": {
      "type": "string",
      "enum": [
        "actuation_validation",
        "isolated_counterfactual",
        "interaction_screen",
        "feedback_loop",
        "profile_validation"
      ]
    },
    "fixed_axis_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": [
          "application_send_batch_formation",
          "buffer_copy_coalescing",
          "application_send_turn_planning"
        ]
      }
    },
    "varied_axis_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": [
          "application_send_batch_formation",
          "buffer_copy_coalescing",
          "application_send_turn_planning"
        ]
      }
    },
    "treatment_order": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "treatments": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/treatment" }
    },
    "planned_cells": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/plannedCell" }
    },
    "execution_status": {
      "type": "string",
      "enum": ["ready", "blocked_by_capability", "deferred"]
    },
    "source_document_refs": {
      "type": "array",
      "items": { "$ref": "#/$defs/documentRef" }
    },
    "notes": {
      "type": "array",
      "items": { "type": "string" }
    }
  },
  "$defs": {
    "documentRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["document_id", "schema_version", "document_version", "content_sha256"],
      "properties": {
        "document_id": { "type": "string", "minLength": 1 },
        "schema_version": { "type": "string", "minLength": 1 },
        "document_version": { "type": "integer", "minimum": 1 },
        "content_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      }
    },
    "treatment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["treatment_id", "order_index", "axis_id", "configured_value", "candidate_value"],
      "properties": {
        "treatment_id": { "type": "string", "minLength": 1 },
        "order_index": { "type": "integer", "minimum": 0 },
        "axis_id": {
          "type": "string",
          "enum": [
            "application_send_batch_formation",
            "buffer_copy_coalescing",
            "application_send_turn_planning"
          ]
        },
        "configured_value": {
          "type": "string",
          "enum": [
            "legacy_current",
            "single_eligible",
            "memory_conservative",
            "conservative"
          ]
        },
        "forced_value": {
          "type": "string",
          "enum": [
            "legacy_current",
            "single_eligible",
            "memory_conservative",
            "conservative"
          ]
        },
        "candidate_value": {
          "type": "string",
          "enum": [
            "legacy_current",
            "single_eligible",
            "memory_conservative",
            "conservative"
          ]
        },
        "notes": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "plannedCell": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "cell_id",
        "cell_order",
        "treatment_ids",
        "axis_ids",
        "expected_equivalence_group_id",
        "execution_state"
      ],
      "properties": {
        "cell_id": { "type": "string", "minLength": 1 },
        "cell_order": { "type": "integer", "minimum": 0 },
        "treatment_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "axis_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": [
              "application_send_batch_formation",
              "buffer_copy_coalescing",
              "application_send_turn_planning"
            ]
          }
        },
        "expected_equivalence_group_id": { "type": "string", "minLength": 1 },
        "execution_state": {
          "type": "string",
          "enum": ["planned", "ready", "blocked", "deferred"]
        },
        "notes": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    }
  }
}
