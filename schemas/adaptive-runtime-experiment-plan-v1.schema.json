{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://incursa.dev/schemas/adaptive-runtime-experiment-plan-v1.schema.json",
  "title": "Adaptive Runtime Experiment Plan v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "document_id",
    "document_version",
    "content_sha256",
    "trace_references",
    "active_behavior_authorization",
    "performance_acceptance_authorization",
    "experiment_plan_id",
    "family_id",
    "experiment_type",
    "fixed_axis_ids",
    "varied_axis_ids",
    "treatment_order",
    "treatments",
    "planned_cells",
    "execution_status"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "adaptive-runtime-experiment-plan-v1"
    },
    "document_id": { "type": "string", "minLength": 1 },
    "document_version": { "type": "integer", "const": 1 },
    "content_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "trace_references": {
      "type": "object",
      "additionalProperties": false,
      "required": ["requirement_ids", "architecture_ids", "work_item_ids", "verification_ids"],
      "properties": {
        "requirement_ids": {
          "type": "array",
          "minItems": 4,
          "maxItems": 8,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": [
              "REQ-QUIC-CRT-0198",
              "REQ-QUIC-CRT-0199",
              "REQ-QUIC-CRT-0200",
              "REQ-QUIC-CRT-0201",
              "REQ-QUIC-CRT-0202",
              "REQ-QUIC-CRT-0203",
              "REQ-QUIC-CRT-0204",
              "REQ-QUIC-CRT-0205"
            ]
          }
        },
        "architecture_ids": {
          "type": "array",
          "minItems": 1,
          "maxItems": 2,
          "uniqueItems": true,
          "items": { "type": "string", "enum": ["ARC-QUIC-CRT-0089", "ARC-QUIC-CRT-0092"] }
        },
        "work_item_ids": {
          "type": "array",
          "minItems": 1,
          "maxItems": 2,
          "uniqueItems": true,
          "items": { "type": "string", "enum": ["WI-QUIC-CRT-0090", "WI-QUIC-CRT-0093"] }
        },
        "verification_ids": {
          "type": "array",
          "minItems": 1,
          "maxItems": 2,
          "uniqueItems": true,
          "items": { "type": "string", "enum": ["VER-QUIC-CRT-0091", "VER-QUIC-CRT-0094"] }
        }
      }
    },
    "active_behavior_authorization": { "type": "boolean", "const": false },
    "performance_acceptance_authorization": { "type": "boolean", "const": false },
    "execution_purpose": {
      "type": "string",
      "enum": ["correctness_only", "verification_only", "dry_run_only"]
    },
    "reviewed_actuation_proof_refs": {
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/documentRef" }
    },
    "experiment_plan_id": { "type": "string", "minLength": 1 },
    "family_id": { "type": "string", "minLength": 1 },
    "experiment_type": {
      "type": "string",
      "enum": [
        "actuation_validation",
        "isolated_counterfactual",
        "interaction_screen",
        "feedback_loop",
        "profile_validation"
      ]
    },
    "fixed_axis_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/axisId" }
    },
    "varied_axis_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/axisId" }
    },
    "fixed_axis_values": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["axis_id", "configured_value"],
        "properties": {
          "axis_id": { "$ref": "#/$defs/axisId" },
          "configured_value": { "$ref": "#/$defs/policyValue" }
        }
      }
    },
    "treatment_order": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "treatments": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/treatment" }
    },
    "planned_cells": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/plannedCell" }
    },
    "execution_status": {
      "type": "string",
      "enum": ["ready", "blocked_by_capability", "deferred"]
    },
    "expected_capabilities": {
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/capabilityExpectation" }
    },
    "preserve_equivalent_cells_for_verification": { "type": "boolean" },
    "required_predicate_refs": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "history_controls": { "$ref": "#/$defs/historyControls" },
    "profile_definition": { "$ref": "#/$defs/profileDefinition" },
    "execution_order_policy": {
      "type": "string",
      "enum": ["deterministic", "randomized"]
    },
    "randomization_seed": { "type": "integer", "minimum": 0 },
    "source_document_refs": {
      "type": "array",
      "items": { "$ref": "#/$defs/documentRef" }
    },
    "notes": {
      "type": "array",
      "items": { "type": "string" }
    }
  },
  "$defs": {
    "documentRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["document_id", "schema_version", "document_version", "content_sha256"],
      "properties": {
        "document_id": { "type": "string", "minLength": 1 },
        "schema_version": { "type": "string", "minLength": 1 },
        "document_version": { "type": "integer", "minimum": 1 },
        "content_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      }
    },
    "axisId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:_[a-z0-9]+)*$"
    },
    "policyValue": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:_[a-z0-9]+)*$"
    },
    "capabilityExpectation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["capability_id", "expectation", "resolution"],
      "properties": {
        "capability_id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9]*(?:_[a-z0-9]+)*$"
        },
        "expectation": {
          "type": "string",
          "enum": ["required", "expected"]
        },
        "resolution": {
          "type": "string",
          "enum": ["deferred_to_manifest", "pending"]
        }
      }
    },
    "historyControls": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "warmup",
        "initial_state",
        "reset_carryover",
        "ordered_observations",
        "recovery",
        "cooldown",
        "terminal_handling"
      ],
      "properties": {
        "warmup": { "type": "string", "minLength": 1 },
        "initial_state": { "type": "string", "minLength": 1 },
        "reset_carryover": {
          "type": "string",
          "enum": ["reset_each_cell", "carryover_declared"]
        },
        "ordered_observations": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "recovery": { "type": "string", "minLength": 1 },
        "cooldown": { "type": "string", "minLength": 1 },
        "terminal_handling": { "type": "string", "minLength": 1 }
      }
    },
    "profileDefinition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["profile_id", "profile_treatment_ids", "transparent"],
      "properties": {
        "profile_id": { "type": "string", "minLength": 1 },
        "profile_treatment_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "transparent": { "type": "boolean", "const": true }
      }
    },
    "treatment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["treatment_id", "order_index", "axis_id", "configured_value", "candidate_value"],
      "properties": {
        "treatment_id": { "type": "string", "minLength": 1 },
        "order_index": { "type": "integer", "minimum": 0 },
        "axis_id": { "$ref": "#/$defs/axisId" },
        "configured_value": { "$ref": "#/$defs/policyValue" },
        "forced_value": { "$ref": "#/$defs/policyValue" },
        "candidate_value": { "$ref": "#/$defs/policyValue" },
        "notes": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "plannedCell": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "cell_id",
        "cell_order",
        "treatment_ids",
        "axis_ids",
        "expected_equivalence_group_id",
        "execution_state"
      ],
      "properties": {
        "cell_id": { "type": "string", "minLength": 1 },
        "cell_order": { "type": "integer", "minimum": 0 },
        "treatment_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "axis_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/axisId" }
        },
        "expected_equivalence_group_id": { "type": "string", "minLength": 1 },
        "execution_state": {
          "type": "string",
          "enum": ["planned", "ready", "blocked", "deferred"]
        },
        "performance_comparable": { "type": "boolean" },
        "activation_expectation": {
          "type": "string",
          "enum": ["reachable", "structurally_inactive", "unreachable", "unknown"]
        },
        "notes": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    }
  }
}
