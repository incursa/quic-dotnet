{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/incursa/quic-dotnet/schemas/adaptive-runtime-experiment-evidence-projection-v3.schema.json",
  "title": "Adaptive runtime experiment evidence projection v3",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "document_id",
    "document_version",
    "content_sha256",
    "authority_chain",
    "experiment_plan",
    "plan_validation",
    "compiled_execution_manifest",
    "experiment_run",
    "host_fingerprint",
    "binary_cohort",
    "workload_instance",
    "requested_workload_shape",
    "effective_workload_shape",
    "operation_evidence",
    "behavior_materialization",
    "outcome_materialization",
    "metric_observations",
    "artifact_inventory",
    "classifications",
    "connection_epochs",
    "axis_decisions",
    "operation_identities",
    "effective_behavior_aggregates",
    "operation_outcome_aggregates",
    "provenance_versions",
    "active_behavior_authorization",
    "performance_acceptance_authorization",
    "trace_references"
  ],
  "properties": {
    "schema_version": { "const": "adaptive-runtime-experiment-evidence-projection-v3" },
    "document_id": { "$ref": "#/$defs/id" },
    "document_version": { "const": 3 },
    "content_sha256": { "$ref": "#/$defs/hash" },
    "authority_chain": {
      "type": "array",
      "minItems": 15,
      "maxItems": 15,
      "items": { "$ref": "#/$defs/documentRef" }
    },
    "experiment_plan": { "$ref": "#/$defs/documentRef" },
    "plan_validation": { "$ref": "#/$defs/documentRef" },
    "compiled_execution_manifest": { "$ref": "#/$defs/documentRef" },
    "experiment_run": { "$ref": "#/$defs/documentRef" },
    "host_fingerprint": { "$ref": "#/$defs/documentRef" },
    "binary_cohort": { "$ref": "#/$defs/documentRef" },
    "workload_instance": { "$ref": "#/$defs/documentRef" },
    "requested_workload_shape": { "$ref": "#/$defs/documentRef" },
    "effective_workload_shape": { "$ref": "#/$defs/documentRef" },
    "operation_evidence": { "$ref": "#/$defs/documentRef" },
    "behavior_materialization": { "$ref": "#/$defs/documentRef" },
    "outcome_materialization": { "$ref": "#/$defs/documentRef" },
    "metric_observations": { "$ref": "#/$defs/documentRef" },
    "artifact_inventory": { "$ref": "#/$defs/documentRef" },
    "classifications": { "$ref": "#/$defs/documentRef" },
    "connection_epochs": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/epoch" } },
    "axis_decisions": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/decisionJoin" } },
    "operation_identities": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/operationIdentity" } },
    "effective_behavior_aggregates": { "type": "array", "items": { "$ref": "#/$defs/behaviorAggregateJoin" } },
    "operation_outcome_aggregates": { "type": "array", "items": { "$ref": "#/$defs/outcomeAggregateJoin" } },
    "provenance_versions": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/id" } },
    "active_behavior_authorization": { "const": false },
    "performance_acceptance_authorization": { "const": false },
    "trace_references": { "$ref": "#/$defs/traceReferences" }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._:-]*$" },
    "hash": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "positiveInteger": { "type": "integer", "minimum": 1 },
    "documentRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["document_id", "schema_version", "document_version", "content_sha256"],
      "properties": {
        "document_id": { "$ref": "#/$defs/id" },
        "schema_version": { "$ref": "#/$defs/id" },
        "document_version": { "$ref": "#/$defs/positiveInteger" },
        "content_sha256": { "$ref": "#/$defs/hash" }
      }
    },
    "epoch": {
      "type": "object",
      "additionalProperties": false,
      "required": ["run_id", "connection_key", "epoch_sequence"],
      "properties": {
        "run_id": { "$ref": "#/$defs/id" },
        "connection_key": { "$ref": "#/$defs/id" },
        "epoch_sequence": { "$ref": "#/$defs/positiveInteger" }
      }
    },
    "decisionJoin": {
      "type": "object",
      "additionalProperties": false,
      "required": ["run_id", "connection_key", "epoch_sequence", "axis_id", "decision_instance_id"],
      "properties": {
        "run_id": { "$ref": "#/$defs/id" },
        "connection_key": { "$ref": "#/$defs/id" },
        "epoch_sequence": { "$ref": "#/$defs/positiveInteger" },
        "axis_id": { "$ref": "#/$defs/id" },
        "decision_instance_id": { "$ref": "#/$defs/positiveInteger" }
      }
    },
    "operationIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["identity_version", "operation_key", "run_id", "connection_key", "epoch_sequence", "axis_id", "decision_instance_id", "operation_id"],
      "properties": {
        "identity_version": { "const": 1 },
        "operation_key": { "type": "string", "pattern": "^operation_identity_v1:[0-9a-f]{64}$" },
        "run_id": { "$ref": "#/$defs/id" },
        "connection_key": { "$ref": "#/$defs/id" },
        "epoch_sequence": { "$ref": "#/$defs/positiveInteger" },
        "axis_id": { "$ref": "#/$defs/id" },
        "decision_instance_id": { "$ref": "#/$defs/positiveInteger" },
        "operation_id": { "$ref": "#/$defs/positiveInteger" }
      }
    },
    "behaviorAggregateJoin": {
      "type": "object",
      "additionalProperties": false,
      "required": ["run_id", "connection_key", "epoch_sequence", "axis_id", "behavior_catalog_version", "effective_behavior_id", "source_operation_keys"],
      "properties": {
        "run_id": { "$ref": "#/$defs/id" },
        "connection_key": { "$ref": "#/$defs/id" },
        "epoch_sequence": { "$ref": "#/$defs/positiveInteger" },
        "axis_id": { "$ref": "#/$defs/id" },
        "behavior_catalog_version": { "const": 2 },
        "effective_behavior_id": { "$ref": "#/$defs/id" },
        "source_operation_keys": { "type": "array", "minItems": 1, "items": { "type": "string", "pattern": "^operation_identity_v1:[0-9a-f]{64}$" } }
      }
    },
    "outcomeAggregateJoin": {
      "type": "object",
      "additionalProperties": false,
      "required": ["run_id", "connection_key", "epoch_sequence", "axis_id", "outcome_contract_version", "outcome_id", "source_operation_keys"],
      "properties": {
        "run_id": { "$ref": "#/$defs/id" },
        "connection_key": { "$ref": "#/$defs/id" },
        "epoch_sequence": { "$ref": "#/$defs/positiveInteger" },
        "axis_id": { "$ref": "#/$defs/id" },
        "outcome_contract_version": { "const": 2 },
        "outcome_id": { "$ref": "#/$defs/id" },
        "source_operation_keys": { "type": "array", "minItems": 1, "items": { "type": "string", "pattern": "^operation_identity_v1:[0-9a-f]{64}$" } }
      }
    },
    "traceReferences": {
      "type": "object",
      "additionalProperties": false,
      "required": ["requirement_ids", "architecture_ids", "work_item_ids", "verification_ids"],
      "properties": {
        "requirement_ids": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "architecture_ids": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "work_item_ids": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "verification_ids": { "type": "array", "minItems": 1, "items": { "type": "string" } }
      }
    }
  }
}
