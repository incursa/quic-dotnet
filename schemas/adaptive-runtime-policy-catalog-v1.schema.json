{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://incursa.dev/schemas/adaptive-runtime-policy-catalog-v1.schema.json",
  "title": "Adaptive Runtime Policy Catalog v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "catalogId",
    "catalogVersion",
    "generatedUtc",
    "measurementOnly",
    "seamLocal",
    "activationAuthorized",
    "scope",
    "entries",
    "notes"
  ],
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "adaptive-runtime-policy-catalog-v1"
    },
    "catalogId": {
      "type": "string",
      "minLength": 1
    },
    "catalogVersion": {
      "type": "string",
      "minLength": 1
    },
    "generatedUtc": {
      "type": "string",
      "format": "date-time"
    },
    "measurementOnly": {
      "type": "boolean",
      "const": true
    },
    "seamLocal": {
      "type": "boolean",
      "const": true
    },
    "activationAuthorized": {
      "type": "boolean",
      "const": false
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "requirementIds",
        "axisIds",
        "blockedCapabilities"
      ],
      "properties": {
        "requirementIds": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": [
              "REQ-QUIC-CRT-0170",
              "REQ-QUIC-CRT-0171",
              "REQ-QUIC-CRT-0172"
            ]
          }
        },
        "axisIds": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/axisId"
          }
        },
        "blockedCapabilities": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": [
              "active_internal",
              "online_learning",
              "production_activation",
              "axis_widening",
              "runtime_mode_reclassification"
            ]
          }
        }
      }
    },
    "entries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/catalogEntry"
      }
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "$defs": {
    "axisId": {
      "type": "string",
      "enum": [
        "receive_credit_publication",
        "oversized_write_admission",
        "application_send_turn_planning",
        "application_datagram_batching",
        "application_send_batch_formation",
        "queued_send_burst_budget",
        "application_send_pressure_classification",
        "ready_stream_fairness",
        "actor_work_quantum",
        "packet_flush_cadence",
        "backpressure_bounds",
        "runtime_pressure_advisor"
      ]
    },
    "policyValue": {
      "type": "string",
      "enum": [
        "legacy_current",
        "conservative",
        "immediate",
        "read_dominant_batch",
        "static_current",
        "candidate",
        "not_applicable"
      ]
    },
    "catalogEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "entryId",
        "axisId",
        "catalogStatus",
        "readiness",
        "runtimeAuthority",
        "measurementModes",
        "policyValues",
        "candidatePolicies",
        "forceableForCampaigns",
        "shadowSupported",
        "activationAuthorized",
        "sourceRequirements",
        "retainedNegativeEvidenceClasses",
        "notes"
      ],
      "properties": {
        "entryId": {
          "type": "string",
          "minLength": 1
        },
        "axisId": {
          "$ref": "#/$defs/axisId"
        },
        "catalogStatus": {
          "type": "string",
          "const": "experimental_measurement_only"
        },
        "readiness": {
          "type": "string",
          "enum": [
            "executable_measurement",
            "forceable_test_seam",
            "inventory_only",
            "observation_only"
          ]
        },
        "runtimeAuthority": {
          "type": "string",
          "minLength": 1
        },
        "measurementModes": {
          "type": "array",
          "minItems": 0,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": [
              "shadow",
              "forced"
            ]
          }
        },
        "policyValues": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/policyValue"
          }
        },
        "candidatePolicies": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/policyValue"
          }
        },
        "forceableForCampaigns": {
          "type": "boolean"
        },
        "shadowSupported": {
          "type": "boolean"
        },
        "activationAuthorized": {
          "type": "boolean",
          "const": false
        },
        "sourceRequirements": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": [
              "REQ-QUIC-CRT-0170",
              "REQ-QUIC-CRT-0171",
              "REQ-QUIC-CRT-0172"
            ]
          }
        },
        "retainedNegativeEvidenceClasses": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": [
              "universal_batching",
              "half_window_duplex_reactivation",
              "quarter_window_duplex_reactivation",
              "non_sticky_duplex_fallback",
              "lock_based_selector",
              "scheduler_quantum",
              "other"
            ]
          }
        },
        "notes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    }
  }
}
