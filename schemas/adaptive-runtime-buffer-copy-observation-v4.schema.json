{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://incursa.dev/schemas/adaptive-runtime-buffer-copy-observation-v4.schema.json",
  "title": "Adaptive Runtime Buffer Copy Observation v4",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "operationSequence",
    "mode",
    "path",
    "operation",
    "decisionBoundary",
    "joinOperationSequence",
    "legalLogicalBytes",
    "logicalBytes",
    "copiedBytes",
    "legalSourceSegmentCount",
    "sourceSegmentCount",
    "destinationSegmentCount",
    "requestedCapacityBytes",
    "retainedCapacityBytes",
    "forcedValue",
    "shadowRecommendation",
    "selectedValue",
    "appliedValue",
    "selectionSource",
    "reasonCode",
    "safetyOverride",
    "latchLifetime",
    "fallbackApplied",
    "phaseAfter",
    "disposalStarted",
    "validity",
    "policyAxisId",
    "observationContractVersion",
    "ruleVersion",
    "snapshotVersion",
    "reasonVersion",
    "provenanceVersion"
  ],
  "properties": {
    "operationSequence": { "$ref": "#/$defs/positiveInteger" },
    "mode": {
      "enum": ["Disabled", "ObserveOnly", "Shadow"]
    },
    "path": {
      "enum": [
        "ApplicationWriteRequest",
        "OversizedRawQueue",
        "FormattedStreamPayload",
        "CombinedApplicationSend",
        "SentPacketPlaintextRetention",
        "RetransmissionClone",
        "ReceiveSegment",
        "OutboundPacketProtection"
      ]
    },
    "operation": {
      "enum": [
        "Copy",
        "ReuseAndCopy",
        "Format",
        "Combine",
        "Retain",
        "Clone",
        "Protect"
      ]
    },
    "decisionBoundary": {
      "enum": [
        "StreamWriteRetry",
        "LogicalWriteAdmission",
        "PacketPlan",
        "SentPacketRetention",
        "RetransmissionClone",
        "ReceiveSegmentInsertion",
        "PacketProtection"
      ]
    },
    "joinOperationSequence": {
      "type": ["integer", "null"]
    },
    "legalLogicalBytes": { "$ref": "#/$defs/unsignedInteger" },
    "logicalBytes": { "$ref": "#/$defs/unsignedInteger" },
    "copiedBytes": { "$ref": "#/$defs/unsignedInteger" },
    "legalSourceSegmentCount": { "$ref": "#/$defs/unsignedInteger" },
    "sourceSegmentCount": { "$ref": "#/$defs/unsignedInteger" },
    "destinationSegmentCount": { "$ref": "#/$defs/unsignedInteger" },
    "requestedCapacityBytes": { "$ref": "#/$defs/unsignedInteger" },
    "retainedCapacityBytes": { "$ref": "#/$defs/unsignedInteger" },
    "forcedValue": {
      "type": ["string", "null"],
      "enum": ["LegacyCurrent", "MemoryConservative", null]
    },
    "shadowRecommendation": {
      "type": ["string", "null"],
      "enum": ["LegacyCurrent", "MemoryConservative", null]
    },
    "selectedValue": {
      "enum": ["LegacyCurrent", "MemoryConservative"]
    },
    "appliedValue": {
      "enum": ["LegacyCurrent", "MemoryConservative"]
    },
    "selectionSource": {
      "enum": ["LegacyCurrent", "Forced", "ShadowRule", "SafetyOverride"]
    },
    "reasonCode": {
      "enum": [
        "LegacyCopy",
        "ExistingCapacityReused",
        "ObserveOnly",
        "Forced",
        "ShadowMemoryConservative",
        "MissingInput",
        "StaleInput",
        "ArithmeticSaturated",
        "Contradictory",
        "OutOfDomain",
        "InvalidInput",
        "LifecycleGuard",
        "NotApplicable"
      ]
    },
    "safetyOverride": {
      "enum": ["None", "InvalidObservation", "Lifecycle"]
    },
    "latchLifetime": { "const": "BufferLifetime" },
    "fallbackApplied": { "type": "boolean" },
    "phaseAfter": {
      "enum": ["Establishing", "Active", "Closing", "Draining", "Discarded"]
    },
    "disposalStarted": { "type": "boolean" },
    "validity": { "type": ["string", "integer"] },
    "policyAxisId": { "const": "buffer_copy_coalescing" },
    "observationContractVersion": {
      "const": "quic-buffer-copy-observation-v4"
    },
    "ruleVersion": {
      "const": "quic-buffer-copy-memory-conservative-rule-v1"
    },
    "snapshotVersion": {
      "const": "quic-buffer-copy-policy-snapshot-v1"
    },
    "reasonVersion": { "const": "quic-buffer-copy-reason-v2" },
    "provenanceVersion": { "const": "quic-buffer-copy-provenance-v4" },
    "coalescingEvidence": { "type": "object" }
  },
  "$defs": {
    "unsignedInteger": {
      "type": "integer",
      "minimum": 0
    },
    "positiveInteger": {
      "type": "integer",
      "minimum": 1
    }
  }
}
