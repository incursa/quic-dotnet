{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/incursa/quic-dotnet/schemas/adaptive-runtime-actuation-proof-review-v1.schema.json",
  "title": "Adaptive runtime actuation proof independent review v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "document_id",
    "document_version",
    "content_sha256",
    "review_id",
    "candidate_ref",
    "axis_id",
    "policy_value",
    "review_outcome",
    "reviewer_tool_version",
    "source_commit",
    "binary_sha256",
    "recomputed_behavior_materialization_sha256",
    "recomputed_outcome_materialization_sha256",
    "recomputed_projection_sha256",
    "assertion_results",
    "failure_codes",
    "active_behavior_authorization",
    "performance_acceptance_authorization",
    "trace_references"
  ],
  "properties": {
    "schema_version": { "const": "adaptive-runtime-actuation-proof-review-v1" },
    "document_id": { "$ref": "#/$defs/id" },
    "document_version": { "const": 1 },
    "content_sha256": { "$ref": "#/$defs/hash" },
    "review_id": { "$ref": "#/$defs/id" },
    "candidate_ref": { "$ref": "#/$defs/documentRef" },
    "axis_id": {
      "enum": [
        "application_send_batch_formation",
        "buffer_copy_coalescing"
      ]
    },
    "policy_value": {
      "enum": ["single_eligible", "memory_conservative"]
    },
    "review_outcome": { "enum": ["passed", "failed", "inconclusive"] },
    "reviewer_tool_version": { "$ref": "#/$defs/id" },
    "source_commit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "binary_sha256": { "$ref": "#/$defs/hash" },
    "recomputed_behavior_materialization_sha256": { "$ref": "#/$defs/hash" },
    "recomputed_outcome_materialization_sha256": { "$ref": "#/$defs/hash" },
    "recomputed_projection_sha256": { "$ref": "#/$defs/hash" },
    "assertion_results": {
      "type": "array",
      "minItems": 18,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["assertion_id", "status", "evidence"],
        "properties": {
          "assertion_id": {
            "enum": [
              "adjacent_axes_legacy",
              "activation_predicate_reached",
              "behavior_catalog_materialization_recomputed",
              "binary_identity_exact",
              "candidate_value_exact",
              "complete_identity_reconciled",
              "fallback_authoritative",
              "immutable_projection_chain_valid",
              "mechanism_event_runtime_derived",
              "no_performance_metric_used",
              "operation_eligible",
              "ordering_and_lower_only_authority",
              "outcome_catalog_materialization_recomputed",
              "policy_value_applied",
              "rollback_restored_legacy",
              "shadow_non_actuating",
              "single_behavior_distinct_axis_forced",
              "source_commit_exact",
              "terminal_release_exact_once"
            ]
          },
          "status": { "enum": ["passed", "failed", "not_applicable"] },
          "evidence": { "type": "string", "minLength": 1 }
        }
      }
    },
    "failure_codes": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "enum": [
          "adjacent_axis_not_legacy",
          "activation_predicate_not_reached",
          "binary_hash_mismatch",
          "candidate_reference_mismatch",
          "candidate_value_mismatch",
          "complete_identity_mismatch",
          "fallback_semantics_invalid",
          "mechanism_evidence_invalid",
          "performance_metric_used",
          "projection_recompute_mismatch",
          "rollback_semantics_invalid",
          "schema_or_hash_invalid",
          "shadow_actuated",
          "source_commit_mismatch",
          "terminal_release_invalid",
          "unexpected_forced_axis_count"
        ]
      }
    },
    "active_behavior_authorization": { "const": false },
    "performance_acceptance_authorization": { "const": false },
    "trace_references": { "$ref": "#/$defs/traceReferences" }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]*$"
    },
    "hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "documentRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "document_id",
        "schema_version",
        "document_version",
        "content_sha256"
      ],
      "properties": {
        "document_id": { "$ref": "#/$defs/id" },
        "schema_version": { "$ref": "#/$defs/id" },
        "document_version": { "type": "integer", "minimum": 1 },
        "content_sha256": { "$ref": "#/$defs/hash" }
      }
    },
    "traceReferences": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "requirement_ids",
        "architecture_ids",
        "work_item_ids",
        "verification_ids"
      ],
      "properties": {
        "requirement_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string" }
        },
        "architecture_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string" }
        },
        "work_item_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string" }
        },
        "verification_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string" }
        }
      }
    }
  }
}
