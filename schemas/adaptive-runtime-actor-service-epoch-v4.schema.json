{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://incursa.dev/schemas/adaptive-runtime-actor-service-epoch-v4.schema.json",
  "title": "Adaptive Runtime Actor Service Epoch Summary v4",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "hasObservation",
    "firstServiceSequence",
    "lastServiceSequence",
    "actorTurnCount",
    "completedTurnCount",
    "skippedTurnCount",
    "faultedTurnCount",
    "connectionEventCount",
    "timerCount",
    "packetReceivedCount",
    "streamCapacityReleaseCount",
    "flowControlCreditUpdateCount",
    "streamOpenCount",
    "streamWriteCount",
    "observedWakeCount",
    "maximumWakePosition",
    "totalServiceTimeMicros",
    "maximumServiceTimeMicros",
    "serviceTimeEwmaMicros",
    "queueDelayObservationCount",
    "totalQueueDelayMicros",
    "maximumQueueDelayMicros",
    "queueDelayEwmaMicros",
    "maximumPendingWorkItemsAfterDequeue",
    "totalEffectCount",
    "applicationSendFollowOnCount",
    "flowControlFollowOnCount",
    "streamCapacityFollowOnCount",
    "validity",
    "interServiceGapObservationCount",
    "totalInterServiceGapMicros",
    "maximumInterServiceGapMicros",
    "interServiceGapEwmaMicros",
    "deadlineLatenessObservationCount",
    "totalDeadlineLatenessMicros",
    "maximumDeadlineLatenessMicros",
    "deadlineLatenessEwmaMicros",
    "serviceContenderObservationCount",
    "maximumServiceContenderCount",
    "contendedTurnCount",
    "acceptedConnectionWorkObservationCount",
    "totalAcceptedConnectionWorkItemsAfterCurrent",
    "maximumAcceptedConnectionWorkItemsAfterCurrent",
    "turnsWithAcceptedConnectionWorkRemaining",
    "epochContractVersion"
  ],
  "properties": {
    "hasObservation": { "type": "boolean" },
    "firstServiceSequence": { "$ref": "#/$defs/unsignedInteger" },
    "lastServiceSequence": { "$ref": "#/$defs/unsignedInteger" },
    "actorTurnCount": { "$ref": "#/$defs/unsignedInteger" },
    "completedTurnCount": { "$ref": "#/$defs/unsignedInteger" },
    "skippedTurnCount": { "$ref": "#/$defs/unsignedInteger" },
    "faultedTurnCount": { "$ref": "#/$defs/unsignedInteger" },
    "connectionEventCount": { "$ref": "#/$defs/unsignedInteger" },
    "timerCount": { "$ref": "#/$defs/unsignedInteger" },
    "packetReceivedCount": { "$ref": "#/$defs/unsignedInteger" },
    "streamCapacityReleaseCount": { "$ref": "#/$defs/unsignedInteger" },
    "flowControlCreditUpdateCount": { "$ref": "#/$defs/unsignedInteger" },
    "streamOpenCount": { "$ref": "#/$defs/unsignedInteger" },
    "streamWriteCount": { "$ref": "#/$defs/unsignedInteger" },
    "observedWakeCount": { "$ref": "#/$defs/unsignedInteger" },
    "maximumWakePosition": { "$ref": "#/$defs/unsignedInteger" },
    "totalServiceTimeMicros": { "$ref": "#/$defs/unsignedInteger" },
    "maximumServiceTimeMicros": { "$ref": "#/$defs/unsignedInteger" },
    "serviceTimeEwmaMicros": { "$ref": "#/$defs/unsignedInteger" },
    "queueDelayObservationCount": { "$ref": "#/$defs/unsignedInteger" },
    "totalQueueDelayMicros": { "$ref": "#/$defs/unsignedInteger" },
    "maximumQueueDelayMicros": { "$ref": "#/$defs/unsignedInteger" },
    "queueDelayEwmaMicros": { "$ref": "#/$defs/unsignedInteger" },
    "maximumPendingWorkItemsAfterDequeue": {
      "$ref": "#/$defs/unsignedInteger"
    },
    "totalEffectCount": { "$ref": "#/$defs/unsignedInteger" },
    "applicationSendFollowOnCount": { "$ref": "#/$defs/unsignedInteger" },
    "flowControlFollowOnCount": { "$ref": "#/$defs/unsignedInteger" },
    "streamCapacityFollowOnCount": { "$ref": "#/$defs/unsignedInteger" },
    "validity": { "type": ["string", "integer"] },
    "interServiceGapObservationCount": { "$ref": "#/$defs/unsignedInteger" },
    "totalInterServiceGapMicros": { "$ref": "#/$defs/unsignedInteger" },
    "maximumInterServiceGapMicros": { "$ref": "#/$defs/unsignedInteger" },
    "interServiceGapEwmaMicros": { "$ref": "#/$defs/unsignedInteger" },
    "deadlineLatenessObservationCount": { "$ref": "#/$defs/unsignedInteger" },
    "totalDeadlineLatenessMicros": { "$ref": "#/$defs/unsignedInteger" },
    "maximumDeadlineLatenessMicros": { "$ref": "#/$defs/unsignedInteger" },
    "deadlineLatenessEwmaMicros": { "$ref": "#/$defs/unsignedInteger" },
    "serviceContenderObservationCount": { "$ref": "#/$defs/unsignedInteger" },
    "maximumServiceContenderCount": { "$ref": "#/$defs/unsignedInteger" },
    "contendedTurnCount": { "$ref": "#/$defs/unsignedInteger" },
    "acceptedConnectionWorkObservationCount": {
      "$ref": "#/$defs/unsignedInteger"
    },
    "totalAcceptedConnectionWorkItemsAfterCurrent": {
      "$ref": "#/$defs/unsignedInteger"
    },
    "maximumAcceptedConnectionWorkItemsAfterCurrent": {
      "$ref": "#/$defs/unsignedInteger"
    },
    "turnsWithAcceptedConnectionWorkRemaining": {
      "$ref": "#/$defs/unsignedInteger"
    },
    "epochContractVersion": {
      "const": "quic-actor-service-epoch-v4"
    }
  },
  "$defs": {
    "unsignedInteger": {
      "type": "integer",
      "minimum": 0
    }
  }
}
