{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://incursa.dev/schemas/adaptive-runtime-experiment-plan-validation-v1.schema.json",
  "title": "Adaptive Runtime Experiment Plan Validation v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "document_id",
    "document_version",
    "content_sha256",
    "trace_references",
    "active_behavior_authorization",
    "performance_acceptance_authorization",
    "validation_id",
    "validated_plan_ref",
    "validation_classification",
    "validation_errors",
    "validation_warnings",
    "equivalence_groups",
    "expanded_planned_cells"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "adaptive-runtime-experiment-plan-validation-v1"
    },
    "document_id": { "type": "string", "minLength": 1 },
    "document_version": { "type": "integer", "const": 1 },
    "content_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "trace_references": {
      "type": "object",
      "additionalProperties": false,
      "required": ["requirement_ids", "architecture_ids", "work_item_ids", "verification_ids"],
      "properties": {
        "requirement_ids": {
          "type": "array",
          "minItems": 4,
          "maxItems": 8,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": [
              "REQ-QUIC-CRT-0198",
              "REQ-QUIC-CRT-0199",
              "REQ-QUIC-CRT-0200",
              "REQ-QUIC-CRT-0201",
              "REQ-QUIC-CRT-0202",
              "REQ-QUIC-CRT-0203",
              "REQ-QUIC-CRT-0204",
              "REQ-QUIC-CRT-0205"
            ]
          }
        },
        "architecture_ids": {
          "type": "array",
          "minItems": 1,
          "maxItems": 2,
          "uniqueItems": true,
          "items": { "type": "string", "enum": ["ARC-QUIC-CRT-0089", "ARC-QUIC-CRT-0092"] }
        },
        "work_item_ids": {
          "type": "array",
          "minItems": 1,
          "maxItems": 2,
          "uniqueItems": true,
          "items": { "type": "string", "enum": ["WI-QUIC-CRT-0090", "WI-QUIC-CRT-0093"] }
        },
        "verification_ids": {
          "type": "array",
          "minItems": 1,
          "maxItems": 2,
          "uniqueItems": true,
          "items": { "type": "string", "enum": ["VER-QUIC-CRT-0091", "VER-QUIC-CRT-0094"] }
        }
      }
    },
    "active_behavior_authorization": { "type": "boolean", "const": false },
    "performance_acceptance_authorization": { "type": "boolean", "const": false },
    "validation_id": { "type": "string", "minLength": 1 },
    "validated_plan_ref": { "$ref": "#/$defs/documentRef" },
    "validation_classification": {
      "type": "string",
      "enum": [
        "valid_actuation",
        "valid_isolated_counterfactual",
        "valid_interaction_screen",
        "valid_feedback_loop",
        "valid_profile_validation",
        "verification_only",
        "capability_pending",
        "blocked",
        "invalid",
        "valid",
        "warning",
        "error"
      ]
    },
    "validation_errors": {
      "type": "array",
      "items": { "$ref": "#/$defs/validationError" }
    },
    "validation_warnings": {
      "type": "array",
      "items": { "$ref": "#/$defs/validationWarning" }
    },
    "cell_counts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "configured",
        "expected_effective",
        "potential_execution",
        "structurally_inactive",
        "capability_pending",
        "rejected",
        "deduplicated",
        "retained_for_verification",
        "behavior_distinctness_unknown"
      ],
      "properties": {
        "configured": { "type": "integer", "minimum": 0 },
        "expected_effective": { "type": "integer", "minimum": 0 },
        "potential_execution": { "type": "integer", "minimum": 0 },
        "structurally_inactive": { "type": "integer", "minimum": 0 },
        "capability_pending": { "type": "integer", "minimum": 0 },
        "rejected": { "type": "integer", "minimum": 0 },
        "deduplicated": { "type": "integer", "minimum": 0 },
        "retained_for_verification": { "type": "integer", "minimum": 0 },
        "behavior_distinctness_unknown": { "type": "integer", "minimum": 0 }
      }
    },
    "equivalence_groups": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/equivalenceGroup" }
    },
    "expanded_planned_cells": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/expandedPlannedCell" }
    },
    "notes": {
      "type": "array",
      "items": { "type": "string" }
    }
  },
  "$defs": {
    "documentRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["document_id", "schema_version", "document_version", "content_sha256"],
      "properties": {
        "document_id": { "type": "string", "minLength": 1 },
        "schema_version": { "type": "string", "minLength": 1 },
        "document_version": { "type": "integer", "minimum": 1 },
        "content_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      }
    },
    "validationError": {
      "type": "object",
      "additionalProperties": false,
      "required": ["error_code", "message"],
      "properties": {
        "error_code": {
          "type": "string",
          "enum": [
            "schema_validation_failed",
            "unknown_field",
            "unknown_axis",
            "unknown_policy_value",
            "unknown_contract_reference",
            "stale_contract_reference",
            "blocked_axis",
            "preparation_only_axis",
            "axis_not_implemented",
            "axis_not_forceable",
            "rollback_proof_missing",
            "actuation_proof_missing",
            "experiment_type_axis_count_invalid",
            "unsupported_experiment_type",
            "unsupported_experiment_family",
            "axis_outside_experiment_family",
            "cross_axis_constraint_violation",
            "fixed_axis_not_legacy_current",
            "fixed_varied_axis_overlap",
            "duplicate_axis_reference",
            "activation_predicate_unreachable",
            "missing_canonical_predicate_reference",
            "feedback_loop_history_missing",
            "opaque_profile_definition",
            "expected_capability_missing",
            "prohibited_runtime_controller_input",
            "equivalent_cells_performance_comparable",
            "hash_mismatch",
            "active_behavior_unauthorized",
            "performance_acceptance_unauthorized"
            ,"duplicate_definition"
            ,"duplicate_edge"
            ,"unknown_reference"
            ,"stale_reference"
            ,"illegal_value"
            ,"unsupported_value"
            ,"blocked_axis_executable"
            ,"preparation_only_axis_executable"
            ,"forbidden_authorization"
            ,"malformed_hash"
            ,"missing_predicate_reference"
            ,"fixed_varied_overlap"
            ,"duplicate_axis_definition"
            ,"illegal_policy_value"
            ,"stale_version_reference"
            ,"stage5_preparation_only_executable"
            ,"active_behavior_authorization_true"
            ,"performance_acceptance_authorization_true"
            ,"invalid_relationship_type"
            ,"duplicate_relationship_edge"
          ]
        },
        "message": { "type": "string", "minLength": 1 },
        "target_ref": { "type": "string" }
      }
    },
    "validationWarning": {
      "type": "object",
      "additionalProperties": false,
      "required": ["warning_code", "message"],
      "properties": {
        "warning_code": {
          "type": "string",
          "enum": [
            "all_configured_values_collapse_to_one_expected_behavior",
            "equivalent_cells_deduplicated",
            "structurally_inactive_cell",
            "capability_resolution_required",
            "behavior_distinctness_unproven",
            "verification_cell_preserved",
            "measurement_freeze_active",
            "profile_execution_deferred"
            ,"equivalence_collapsed"
            ,"promotion_deferred"
            ,"current_combination_blocked"
            ,"verification_only"
            ,"compatibility_only"
          ]
        },
        "message": { "type": "string", "minLength": 1 },
        "target_ref": { "type": "string" }
      }
    },
    "equivalenceGroup": {
      "type": "object",
      "additionalProperties": false,
      "required": ["equivalence_group_id", "member_cell_ids", "equivalence_state"],
      "properties": {
        "equivalence_group_id": { "type": "string", "minLength": 1 },
        "member_cell_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "equivalence_state": {
          "type": "string",
          "enum": ["distinct", "equivalent", "collapsed", "verification_only", "unknown"]
        },
        "expected_behavior_key": { "type": "string", "minLength": 1 },
        "notes": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "expandedPlannedCell": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "cell_id",
        "cell_order",
        "axis_ids",
        "treatment_ids",
        "executable",
        "execution_state"
      ],
      "properties": {
        "cell_id": { "type": "string", "minLength": 1 },
        "cell_order": { "type": "integer", "minimum": 0 },
        "axis_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9]*(?:_[a-z0-9]+)*$"
          }
        },
        "treatment_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "executable": { "type": "boolean" },
        "execution_state": {
          "type": "string",
          "enum": [
            "executable",
            "structurally_inactive",
            "capability_pending",
            "rejected",
            "deduplicated",
            "retained_for_verification",
            "behavior_distinctness_unknown",
            "blocked",
            "valid",
            "deferred"
          ]
        },
        "expected_behavior_class_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "equivalence_group_id": { "type": "string", "minLength": 1 },
        "reason_codes": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "notes": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    }
  }
}
