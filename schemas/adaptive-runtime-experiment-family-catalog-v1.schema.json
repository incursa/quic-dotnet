{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://incursa.dev/schemas/adaptive-runtime-experiment-family-catalog-v1.schema.json",
  "title": "Adaptive Runtime Experiment Family Catalog v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "document_id",
    "document_version",
    "content_sha256",
    "trace_references",
    "active_behavior_authorization",
    "performance_acceptance_authorization",
    "experiment_families"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "adaptive-runtime-experiment-family-catalog-v1"
    },
    "document_id": { "type": "string", "minLength": 1 },
    "document_version": { "type": "integer", "const": 1 },
    "content_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "trace_references": {
      "type": "object",
      "additionalProperties": false,
      "required": ["requirement_ids", "architecture_ids", "work_item_ids", "verification_ids"],
      "properties": {
        "requirement_ids": {
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": [
              "REQ-QUIC-CRT-0198",
              "REQ-QUIC-CRT-0199",
              "REQ-QUIC-CRT-0200",
              "REQ-QUIC-CRT-0201"
            ]
          }
        },
        "architecture_ids": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "const": "ARC-QUIC-CRT-0089" }
        },
        "work_item_ids": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "const": "WI-QUIC-CRT-0090" }
        },
        "verification_ids": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "const": "VER-QUIC-CRT-0091" }
        }
      }
    },
    "active_behavior_authorization": { "type": "boolean", "const": false },
    "performance_acceptance_authorization": { "type": "boolean", "const": false },
    "experiment_families": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/experimentFamily" }
    }
  },
  "$defs": {
    "experimentType": {
      "type": "string",
      "enum": [
        "actuation_validation",
        "isolated_counterfactual",
        "interaction_screen",
        "feedback_loop",
        "profile_validation"
      ]
    },
    "promotionStatus": {
      "type": "string",
      "enum": ["deferred", "blocked", "eligible", "promoted"]
    },
    "historyStatus": {
      "type": "string",
      "enum": ["retained", "deferred", "blocked", "promoted"]
    },
    "documentRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["document_id", "schema_version", "document_version", "content_sha256"],
      "properties": {
        "document_id": { "type": "string", "minLength": 1 },
        "schema_version": { "type": "string", "minLength": 1 },
        "document_version": { "type": "integer", "minimum": 1 },
        "content_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      }
    },
    "historyEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["history_id", "status", "notes"],
      "properties": {
        "history_id": { "type": "string", "minLength": 1 },
        "status": { "$ref": "#/$defs/historyStatus" },
        "source_document_refs": {
          "type": "array",
          "items": { "$ref": "#/$defs/documentRef" }
        },
        "notes": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "promotion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "measurement_authorized", "active_behavior_authorization", "performance_acceptance_authorization"],
      "properties": {
        "status": { "$ref": "#/$defs/promotionStatus" },
        "measurement_authorized": { "type": "boolean", "const": false },
        "active_behavior_authorization": { "type": "boolean", "const": false },
        "performance_acceptance_authorization": { "type": "boolean", "const": false }
      }
    },
    "experimentFamily": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "family_id",
        "contexts",
        "metrics",
        "history",
        "promotion",
        "guard_refs",
        "predicate_refs",
        "supported_experiment_types",
        "blocked_experiment_types",
        "notes"
      ],
      "properties": {
        "family_id": { "type": "string", "minLength": 1 },
        "contexts": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": [
              "application_send_batch_formation",
              "buffer_copy_coalescing",
              "application_send_turn_planning"
            ]
          }
        },
        "metrics": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "history": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/historyEntry" }
        },
        "promotion": { "$ref": "#/$defs/promotion" },
        "guard_refs": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "predicate_refs": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "supported_experiment_types": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": [
              "actuation_validation",
              "isolated_counterfactual",
              "interaction_screen"
            ]
          }
        },
        "blocked_experiment_types": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": ["feedback_loop", "profile_validation"]
          }
        },
        "notes": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    }
  }
}
