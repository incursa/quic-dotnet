{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/incursa/quic-dotnet/schemas/adaptive-runtime-send-composition-interaction-proof-v1.schema.json",
  "title": "Adaptive runtime send-composition interaction proof v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "document_id",
    "document_version",
    "content_sha256",
    "proof_id",
    "source_plan_ref",
    "plan_validation_ref",
    "compiled_manifest_ref",
    "experiment_run_ref",
    "operation_evidence_ref",
    "behavior_materialization_ref",
    "outcome_materialization_ref",
    "projection_ref",
    "interaction_case_ids",
    "operation_count",
    "release_count",
    "review_status",
    "review_outcome",
    "active_behavior_authorization",
    "performance_acceptance_authorization",
    "trace_references"
  ],
  "properties": {
    "schema_version": {
      "const": "adaptive-runtime-send-composition-interaction-proof-v1"
    },
    "document_id": { "$ref": "#/$defs/id" },
    "document_version": { "const": 1 },
    "content_sha256": { "$ref": "#/$defs/hash" },
    "proof_id": { "$ref": "#/$defs/id" },
    "source_plan_ref": { "$ref": "#/$defs/documentRef" },
    "plan_validation_ref": { "$ref": "#/$defs/documentRef" },
    "compiled_manifest_ref": { "$ref": "#/$defs/documentRef" },
    "experiment_run_ref": { "$ref": "#/$defs/documentRef" },
    "operation_evidence_ref": { "$ref": "#/$defs/documentRef" },
    "behavior_materialization_ref": { "$ref": "#/$defs/documentRef" },
    "outcome_materialization_ref": { "$ref": "#/$defs/documentRef" },
    "projection_ref": { "$ref": "#/$defs/documentRef" },
    "interaction_case_ids": {
      "type": "array",
      "minItems": 7,
      "uniqueItems": true,
      "items": {
        "enum": [
          "both_distinct",
          "batch_distinct_buffer_inactive",
          "batch_inactive_buffer_distinct",
          "both_inactive",
          "safety_fallback",
          "shadow_neutrality",
          "rollback"
        ]
      }
    },
    "operation_count": { "type": "integer", "minimum": 11 },
    "release_count": { "type": "integer", "minimum": 4 },
    "review_status": { "const": "candidate" },
    "review_outcome": { "type": "null" },
    "active_behavior_authorization": { "const": false },
    "performance_acceptance_authorization": { "const": false },
    "trace_references": { "$ref": "#/$defs/trace" }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]*$"
    },
    "hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "documentRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "document_id",
        "schema_version",
        "document_version",
        "content_sha256"
      ],
      "properties": {
        "document_id": { "$ref": "#/$defs/id" },
        "schema_version": { "$ref": "#/$defs/id" },
        "document_version": { "type": "integer", "minimum": 1 },
        "content_sha256": { "$ref": "#/$defs/hash" }
      }
    },
    "trace": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "requirement_ids",
        "architecture_ids",
        "work_item_ids",
        "verification_ids"
      ],
      "properties": {
        "requirement_ids": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string" }
        },
        "architecture_ids": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string" }
        },
        "work_item_ids": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string" }
        },
        "verification_ids": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string" }
        }
      }
    }
  }
}
