{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/incursa/quic-dotnet/schemas/adaptive-runtime-send-admission-cell-result-v1.schema.json",
  "title": "Adaptive runtime send-admission cell correctness result v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "document_id",
    "document_version",
    "content_sha256",
    "cell_id",
    "cell_content_sha256",
    "axis_values",
    "activation_opportunities",
    "behavior_distinct_actuations",
    "inactive_operation_count",
    "fallback_operation_count",
    "guardrail_assertions",
    "cross_axis_assertions",
    "failed_assertions",
    "result",
    "evidence_ref",
    "projection_ref",
    "authorization_ref",
    "active_behavior_authorization",
    "performance_acceptance_authorization",
    "trace_references"
  ],
  "properties": {
    "schema_version": { "const": "adaptive-runtime-send-admission-cell-result-v1" },
    "document_id": { "$ref": "#/$defs/id" },
    "document_version": { "const": 1 },
    "content_sha256": { "$ref": "#/$defs/hash" },
    "cell_id": { "$ref": "#/$defs/id" },
    "cell_content_sha256": { "$ref": "#/$defs/hash" },
    "axis_values": { "$ref": "#/$defs/axisValues" },
    "activation_opportunities": { "$ref": "#/$defs/axisCounts" },
    "behavior_distinct_actuations": { "$ref": "#/$defs/axisCounts" },
    "inactive_operation_count": { "type": "integer", "minimum": 0 },
    "fallback_operation_count": { "type": "integer", "minimum": 0 },
    "guardrail_assertions": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/assertion" }
    },
    "cross_axis_assertions": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/assertion" }
    },
    "failed_assertions": {
      "type": "array",
      "items": { "$ref": "#/$defs/id" }
    },
    "result": {
      "enum": [
        "correctness_passed",
        "activation_incomplete",
        "correctness_failed",
        "execution_blocked"
      ]
    },
    "evidence_ref": { "$ref": "#/$defs/documentRef" },
    "projection_ref": { "$ref": "#/$defs/documentRef" },
    "authorization_ref": { "$ref": "#/$defs/documentRef" },
    "active_behavior_authorization": { "const": false },
    "performance_acceptance_authorization": { "const": false },
    "trace_references": { "$ref": "#/$defs/traceReferences" }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$" },
    "hash": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "axisValues": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "oversized_write_admission_quantum",
        "application_send_batch_formation",
        "buffer_copy_coalescing"
      ],
      "properties": {
        "oversized_write_admission_quantum": { "enum": ["legacy_current", "single_fragment"] },
        "application_send_batch_formation": { "enum": ["legacy_current", "single_eligible"] },
        "buffer_copy_coalescing": { "enum": ["legacy_current", "memory_conservative"] }
      }
    },
    "axisCounts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "oversized_write_admission_quantum",
        "application_send_batch_formation",
        "buffer_copy_coalescing"
      ],
      "properties": {
        "oversized_write_admission_quantum": { "type": "integer", "minimum": 0 },
        "application_send_batch_formation": { "type": "integer", "minimum": 0 },
        "buffer_copy_coalescing": { "type": "integer", "minimum": 0 }
      }
    },
    "assertion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["assertion_id", "passed"],
      "properties": {
        "assertion_id": { "$ref": "#/$defs/id" },
        "passed": { "type": "boolean" }
      }
    },
    "documentRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["document_id", "schema_version", "document_version", "content_sha256"],
      "properties": {
        "document_id": { "$ref": "#/$defs/id" },
        "schema_version": { "$ref": "#/$defs/id" },
        "document_version": { "type": "integer", "minimum": 1 },
        "content_sha256": { "$ref": "#/$defs/hash" }
      }
    },
    "traceReferences": {
      "type": "object",
      "additionalProperties": false,
      "required": ["requirement_ids", "architecture_ids", "work_item_ids", "verification_ids"],
      "properties": {
        "requirement_ids": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "architecture_ids": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "work_item_ids": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "verification_ids": { "type": "array", "minItems": 1, "items": { "type": "string" } }
      }
    }
  }
}
