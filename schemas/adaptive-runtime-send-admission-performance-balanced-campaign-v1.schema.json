{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://incursa.dev/schemas/adaptive-runtime-send-admission-performance-balanced-campaign-v1.schema.json",
  "title": "Adaptive Runtime Send Admission Performance Balanced Campaign v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "document_id",
    "document_version",
    "content_sha256",
    "campaign_ref",
    "factor_space_ref",
    "pilot_result_ref",
    "controller_uri",
    "host_selection",
    "package_selection",
    "design",
    "selected_cells",
    "execution_sequence",
    "cell_bindings",
    "resource_metrics",
    "excluded_values",
    "covering_array_generator_implemented",
    "covering_array_required",
    "covering_array_trigger_effective_cell_count",
    "measurement_capability_authorized",
    "timing_execution_authorized",
    "performance_acceptance_authorization",
    "adaptive_rule_derivation_authorization",
    "active_behavior_authorization",
    "production_activation_authorization",
    "trace_references"
  ],
  "properties": {
    "schema_version": {
      "const": "adaptive-runtime-send-admission-performance-balanced-campaign-v1"
    },
    "document_id": {
      "const": "adaptive_runtime_send_admission_performance_balanced_campaign_v1"
    },
    "document_version": { "const": 1 },
    "content_sha256": { "$ref": "#/$defs/hash" },
    "campaign_ref": { "$ref": "#/$defs/documentRef" },
    "factor_space_ref": { "$ref": "#/$defs/documentRef" },
    "pilot_result_ref": { "$ref": "#/$defs/documentRef" },
    "controller_uri": { "const": "http://10.10.99.176:5088" },
    "host_selection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "placement_policy",
        "worker_selection_owner",
        "required_capabilities"
      ],
      "properties": {
        "placement_policy": { "const": "isolated-pair" },
        "worker_selection_owner": { "const": "controller-owned" },
        "required_capabilities": {
          "const": ["evidenceTier=offline-ml-two-host-vm"]
        }
      }
    },
    "package_selection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "component_package_references",
        "package_target",
        "implementation_id",
        "suite_id",
        "scenario_id",
        "protocol",
        "test_executor_id",
        "load_profile_id",
        "package_backed_execution"
      ],
      "properties": {
        "component_package_references": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": { "$ref": "#/$defs/packageRef" }
        },
        "package_target": { "const": "RawQuic" },
        "implementation_id": { "const": "quic-dotnet-raw-dev" },
        "suite_id": { "const": "quic-transport-v1-comparison" },
        "scenario_id": {
          "const": "quic.transport.multiplex.100x64kb"
        },
        "protocol": { "const": "quic" },
        "test_executor_id": { "const": "quic-go-raw-load" },
        "load_profile_id": { "const": "raw-quic-peer-confidence" },
        "package_backed_execution": { "const": true }
      }
    },
    "design": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "deterministic",
        "cell_count",
        "block_count",
        "repetitions_per_cell",
        "repetitions_per_job",
        "total_job_count",
        "position_balanced",
        "first_order_carryover_balanced"
      ],
      "properties": {
        "kind": { "const": "williams_balanced_latin_square" },
        "deterministic": { "const": true },
        "cell_count": { "const": 8 },
        "block_count": { "const": 8 },
        "repetitions_per_cell": { "const": 8 },
        "repetitions_per_job": { "const": 1 },
        "total_job_count": { "const": 64 },
        "position_balanced": { "const": true },
        "first_order_carryover_balanced": { "const": true }
      }
    },
    "selected_cells": {
      "type": "array",
      "minItems": 8,
      "maxItems": 8,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/cellId" }
    },
    "execution_sequence": {
      "type": "array",
      "minItems": 64,
      "maxItems": 64,
      "items": { "$ref": "#/$defs/cellId" }
    },
    "cell_bindings": {
      "type": "array",
      "minItems": 8,
      "maxItems": 8,
      "items": { "$ref": "#/$defs/cellBinding" }
    },
    "resource_metrics": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "target_runtime_counters_requested",
        "load_process_metrics_required",
        "bounded_server_stdout_max_bytes"
      ],
      "properties": {
        "target_runtime_counters_requested": { "const": false },
        "load_process_metrics_required": { "const": true },
        "bounded_server_stdout_max_bytes": { "const": 65536 }
      }
    },
    "excluded_values": {
      "type": "object",
      "additionalProperties": false,
      "required": ["oversized_write_admission_quantum"],
      "properties": {
        "oversized_write_admission_quantum": {
          "const": ["bounded_multi_fragment"]
        }
      }
    },
    "covering_array_generator_implemented": { "const": false },
    "covering_array_required": { "const": false },
    "covering_array_trigger_effective_cell_count": { "const": 65 },
    "measurement_capability_authorized": { "const": true },
    "timing_execution_authorized": { "const": true },
    "performance_acceptance_authorization": { "const": false },
    "adaptive_rule_derivation_authorization": { "const": false },
    "active_behavior_authorization": { "const": false },
    "production_activation_authorization": { "const": false },
    "trace_references": { "$ref": "#/$defs/trace" }
  },
  "$defs": {
    "hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "documentRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "document_id",
        "schema_version",
        "document_version",
        "content_sha256"
      ],
      "properties": {
        "document_id": { "type": "string", "minLength": 1 },
        "schema_version": { "type": "string", "minLength": 1 },
        "document_version": { "type": "integer", "minimum": 1 },
        "content_sha256": { "$ref": "#/$defs/hash" }
      }
    },
    "packageRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["package_id", "package_version", "sha256"],
      "properties": {
        "package_id": { "type": "string", "minLength": 1 },
        "package_version": { "type": "string", "minLength": 1 },
        "sha256": { "$ref": "#/$defs/hash" }
      }
    },
    "cellId": {
      "type": "string",
      "enum": ["a0", "a1", "a2", "a3", "a4", "a5", "a6", "a7"]
    },
    "cellBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "cell_id",
        "content_sha256",
        "oversized_write_admission_quantum",
        "application_send_batch_formation",
        "buffer_copy_coalescing"
      ],
      "properties": {
        "cell_id": { "$ref": "#/$defs/cellId" },
        "content_sha256": { "$ref": "#/$defs/hash" },
        "oversized_write_admission_quantum": {
          "enum": ["legacy_current", "single_fragment"]
        },
        "application_send_batch_formation": {
          "enum": ["legacy_current", "single_eligible"]
        },
        "buffer_copy_coalescing": {
          "enum": ["legacy_current", "memory_conservative"]
        }
      }
    },
    "trace": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "requirement_ids",
        "architecture_ids",
        "work_item_ids",
        "verification_ids"
      ],
      "properties": {
        "requirement_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string" }
        },
        "architecture_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string" }
        },
        "work_item_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string" }
        },
        "verification_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string" }
        }
      }
    }
  }
}
