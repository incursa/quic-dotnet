{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "document_id",
    "document_version",
    "content_sha256",
    "pilot_ref",
    "compiled_manifest_ref",
    "execution_manifest_ref",
    "source_commit",
    "source_dirty_state",
    "controller_uri",
    "execution_sequence",
    "worker_pair",
    "workload",
    "run_counts",
    "cells",
    "directional_comparisons",
    "conclusion",
    "covering_array",
    "limitations",
    "performance_acceptance_authorization",
    "adaptive_rule_derivation_authorization",
    "active_behavior_authorization",
    "production_activation_authorization",
    "trace_references"
  ],
  "properties": {
    "schema_version": {
      "const": "adaptive-runtime-send-admission-performance-pilot-result-v1"
    },
    "document_id": {
      "const": "adaptive_runtime_send_admission_performance_pilot_result_v1"
    },
    "document_version": { "const": 1 },
    "content_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "pilot_ref": { "$ref": "#/$defs/documentRef" },
    "compiled_manifest_ref": { "$ref": "#/$defs/documentRef" },
    "execution_manifest_ref": { "$ref": "#/$defs/documentRef" },
    "source_commit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "source_dirty_state": { "const": "clean" },
    "controller_uri": {
      "type": "string",
      "format": "uri"
    },
    "execution_sequence": {
      "const": ["a0", "a4", "a3", "a7"]
    },
    "worker_pair": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "topology_classification",
        "evidence_tier",
        "identity_caveat",
        "sut",
        "load"
      ],
      "properties": {
        "topology_classification": {
          "const": "independent_physical_hosts"
        },
        "evidence_tier": {
          "const": "offline-ml-two-host-vm"
        },
        "identity_caveat": {
          "const": "duplicate-machine-id-user-attested-physical-separation"
        },
        "sut": { "$ref": "#/$defs/worker" },
        "load": { "$ref": "#/$defs/worker" }
      }
    },
    "workload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "suite_id",
        "scenario_id",
        "protocol",
        "test_executor_id",
        "load_profile_id",
        "repetitions_per_cell"
      ],
      "properties": {
        "suite_id": { "const": "quic-transport-v1-comparison" },
        "scenario_id": {
          "const": "quic.transport.multiplex.100x64kb"
        },
        "protocol": { "const": "quic" },
        "test_executor_id": { "const": "quic-go-raw-load" },
        "load_profile_id": { "const": "raw-quic-peer-confidence" },
        "repetitions_per_cell": { "const": 2 }
      }
    },
    "run_counts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "cells",
        "repetitions",
        "successful_repetitions",
        "failed_repetitions",
        "timeout_requests"
      ],
      "properties": {
        "cells": { "const": 4 },
        "repetitions": { "const": 8 },
        "successful_repetitions": { "const": 8 },
        "failed_repetitions": { "const": 0 },
        "timeout_requests": { "const": 0 }
      }
    },
    "cells": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": { "$ref": "#/$defs/cell" }
    },
    "directional_comparisons": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "cell_id",
          "versus_cell_id",
          "requests_per_second_difference_percent",
          "latency_p95_difference_percent",
          "classification"
        ],
        "properties": {
          "cell_id": {
            "enum": ["a4", "a3", "a7"]
          },
          "versus_cell_id": { "const": "a0" },
          "requests_per_second_difference_percent": {
            "type": "number"
          },
          "latency_p95_difference_percent": {
            "type": "number"
          },
          "classification": { "const": "directional_only" }
        }
      }
    },
    "conclusion": {
      "const": "pilot_completed_directional_only"
    },
    "covering_array": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "generator_implemented",
        "required_for_current_eight_cell_family",
        "trigger_effective_cell_count"
      ],
      "properties": {
        "generator_implemented": { "const": false },
        "required_for_current_eight_cell_family": { "const": false },
        "trigger_effective_cell_count": { "const": 65 }
      }
    },
    "limitations": {
      "type": "array",
      "minItems": 7,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "performance_acceptance_authorization": { "const": false },
    "adaptive_rule_derivation_authorization": { "const": false },
    "active_behavior_authorization": { "const": false },
    "production_activation_authorization": { "const": false },
    "trace_references": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "requirement_ids",
        "architecture_ids",
        "work_item_ids",
        "verification_ids"
      ],
      "properties": {
        "requirement_ids": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "architecture_ids": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "work_item_ids": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "verification_ids": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    }
  },
  "$defs": {
    "documentRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "document_id",
        "schema_version",
        "document_version",
        "content_sha256"
      ],
      "properties": {
        "document_id": { "type": "string", "minLength": 1 },
        "schema_version": { "type": "string", "minLength": 1 },
        "document_version": { "type": "integer", "minimum": 1 },
        "content_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "worker": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "node_id",
        "physical_host_id",
        "logical_processor_count",
        "total_memory_bytes"
      ],
      "properties": {
        "node_id": { "type": "string", "minLength": 1 },
        "physical_host_id": { "type": "string", "minLength": 1 },
        "logical_processor_count": {
          "type": "integer",
          "minimum": 1
        },
        "total_memory_bytes": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "policyValues": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "oversized_write_admission_quantum",
        "application_send_batch_formation",
        "buffer_copy_coalescing"
      ],
      "properties": {
        "oversized_write_admission_quantum": {
          "enum": ["legacy_current", "single_fragment"]
        },
        "application_send_batch_formation": {
          "enum": ["legacy_current", "single_eligible"]
        },
        "buffer_copy_coalescing": {
          "enum": ["legacy_current", "memory_conservative"]
        }
      }
    },
    "packageRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["package_id", "package_version", "sha256"],
      "properties": {
        "package_id": { "const": "quic-dotnet-raw-dev" },
        "package_version": { "type": "string", "minLength": 1 },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "topology": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "classification",
        "sut_node_id",
        "sut_physical_host_id",
        "load_node_id",
        "load_physical_host_id"
      ],
      "properties": {
        "classification": { "const": "independent_physical_hosts" },
        "sut_node_id": { "const": "plab-worker-x64-02" },
        "sut_physical_host_id": { "const": "plab-worker-x64-02" },
        "load_node_id": { "const": "plab-worker-x64-03" },
        "load_physical_host_id": { "const": "plab-worker-x64-03" }
      }
    },
    "repetition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repetition",
        "requests_per_second",
        "useful_bytes_per_second",
        "latency_p50_ms",
        "latency_p95_ms",
        "total_requests",
        "successful_requests",
        "failed_requests",
        "timeout_requests",
        "bytes_sent",
        "bytes_received",
        "load_generator_saturation_status"
      ],
      "properties": {
        "repetition": { "enum": [1, 2] },
        "requests_per_second": { "type": "number", "exclusiveMinimum": 0 },
        "useful_bytes_per_second": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "latency_p50_ms": { "type": "number", "minimum": 0 },
        "latency_p95_ms": { "type": "number", "minimum": 0 },
        "total_requests": { "type": "integer", "minimum": 1 },
        "successful_requests": { "type": "integer", "minimum": 1 },
        "failed_requests": { "const": 0 },
        "timeout_requests": { "const": 0 },
        "bytes_sent": { "type": "integer", "minimum": 1 },
        "bytes_received": { "type": "integer", "minimum": 1 },
        "load_generator_saturation_status": {
          "const": "load-generator-saturation-not-detected"
        }
      }
    },
    "midpoint": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "requests_per_second",
        "useful_bytes_per_second",
        "latency_p50_ms",
        "latency_p95_ms"
      ],
      "properties": {
        "requests_per_second": { "type": "number", "exclusiveMinimum": 0 },
        "useful_bytes_per_second": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "latency_p50_ms": { "type": "number", "minimum": 0 },
        "latency_p95_ms": { "type": "number", "minimum": 0 }
      }
    },
    "boundedAggregate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "epoch_count",
        "stdout_bytes",
        "connection_count",
        "application_send_batch_evidence_count",
        "oversized_write_evidence_count",
        "oversized_committed_bytes",
        "buffer_copy_operation_count",
        "owner_release_count",
        "arithmetic_saturated"
      ],
      "properties": {
        "epoch_count": { "type": "integer", "minimum": 1 },
        "stdout_bytes": { "type": "integer", "minimum": 1, "maximum": 65536 },
        "connection_count": { "type": "integer", "minimum": 1 },
        "application_send_batch_evidence_count": {
          "type": "integer",
          "minimum": 1
        },
        "oversized_write_evidence_count": {
          "type": "integer",
          "minimum": 1
        },
        "oversized_committed_bytes": {
          "type": "integer",
          "minimum": 1
        },
        "buffer_copy_operation_count": {
          "type": "integer",
          "minimum": 1
        },
        "owner_release_count": { "type": "integer", "minimum": 1 },
        "arithmetic_saturated": { "const": false }
      }
    },
    "cell": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "cell_id",
        "cell_content_sha256",
        "policy_values",
        "job_id",
        "run_id",
        "implementation_package",
        "topology",
        "repetitions",
        "descriptive_midpoint",
        "bounded_aggregate"
      ],
      "properties": {
        "cell_id": { "enum": ["a0", "a4", "a3", "a7"] },
        "cell_content_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "policy_values": { "$ref": "#/$defs/policyValues" },
        "job_id": {
          "type": "string",
          "pattern": "^job-[0-9a-f]{32}$"
        },
        "run_id": { "type": "string", "minLength": 1 },
        "implementation_package": { "$ref": "#/$defs/packageRef" },
        "topology": { "$ref": "#/$defs/topology" },
        "repetitions": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": { "$ref": "#/$defs/repetition" }
        },
        "descriptive_midpoint": { "$ref": "#/$defs/midpoint" },
        "bounded_aggregate": { "$ref": "#/$defs/boundedAggregate" }
      }
    }
  }
}
