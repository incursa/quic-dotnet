  "artifact_type": "specification",
  "title": "QPACK (RFC 9204)",
  "domain": "quic",
  "capability": "http3",
  "status": "draft",
  "owner": "quic-maintainers",
  "purpose": "Define the standalone QPACK requirements used by HTTP/3 header compression.",
  "scope": "This specification covers QPACK prefixed integers, string literals, the RFC 9204 static table, field-section encoding and decoding with static and literal field lines, dynamic table capacity and entry accounting, insertion and eviction, duplicate entries, absolute/relative/post-base index handling, required insert count and blocked stream handling, and encoder/decoder instruction-stream parsing. It intentionally keeps the QPACK module standalone and does not own HTTP/3 stream dispatch or request/response semantics.",
  "context": "Incursa.Qpack is the standalone header-compression package used by the HTTP/3 layer. The QPACK module must remain independently testable without depending on Incursa.Quic, while HTTP/3 consumes it as a library dependency. Remaining runtime state-capture or restore work for the HTTP/3 integration layer is separate from the core QPACK codec and table implementation traced here.",
  "related_artifacts": [
    "SPEC-QUIC-RFC9114",
    "ARC-QUIC-RFC9204-0001",
    "WI-QUIC-RFC9204-0001",
    "VER-QUIC-RFC9204-0001"
  ],
  "supplemental_sections": [
    {
      "heading": "Standalone Module Boundary",
      "content": "The QPACK package owns the integer codec, string-literal codec, static table, field-section encoding and decoding, dynamic table accounting, blocked-stream bookkeeping, and encoder/decoder instruction parsing. HTTP/3 request and response handling remain the responsibility of the HTTP/3 package that consumes QPACK."
    }
  ],
