      ]
    },
    {
      "id": "REQ-QUIC-RFC9220-0006",
      "title": "Represent RST exceptions with request-cancelled errors",
      "statement": "RST exceptions MUST be represented with a stream error of type H3_REQUEST_CANCELLED.",
      "coverage": {
        "positive": "required",
        "negative": "required",
        "edge": "optional",
        "fuzz": "deferred"
      },
      "trace": {
