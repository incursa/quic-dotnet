      ]
    },
    {
      "id": "REQ-QUIC-RFC9220-0005",
      "title": "Represent orderly closures with FIN",
      "statement": "Orderly TCP-level closures MUST be represented as a FIN bit on the stream.",
      "coverage": {
        "positive": "required",
        "negative": "required",
        "edge": "optional",
        "fuzz": "deferred"
      },
      "trace": {
        "upstream_refs": [
