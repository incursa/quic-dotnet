    {
      "id": "REQ-QUIC-RFC9220-0009",
      "title": "Parse WebSocket tunnel messages",
      "statement": "The HTTP/3 WebSocket tunnel parser MUST expose complete unmasked text, binary, and control messages from WebSocket frames carried on an RFC9220 Extended CONNECT stream.",
      "coverage": {
        "positive": "required",
        "negative": "required",
        "edge": "optional",
        "fuzz": "required"
      },
      "trace": {
        "upstream_refs": [
          "RFC 9220 section 3",
          "RFC 6455 section 5.2",
          "https://www.rfc-editor.org/rfc/rfc9220.html#section-3",
          "https://www.rfc-editor.org/rfc/rfc6455.html#section-5.2"
        ],
        "x_test_refs": [
          "tests/Incursa.Quic.Tests/Http3WebSocketMessageReaderTests.cs::ServerReader_UnmasksMaskedClientTextMessage",
          "tests/Incursa.Quic.Tests/Http3WebSocketMessageReaderTests.cs::ClientReader_AcceptsUnmaskedServerBinaryMessage"
        ]
      },
      "notes": [
        "This parser is the first reusable WebSocket-over-HTTP/3 tunnel component and does not dispatch application handlers."
      ]
    },
    {
      "id": "REQ-QUIC-RFC9220-0010",
      "title": "Reject unmasked client WebSocket frames",
      "statement": "The server-side HTTP/3 WebSocket tunnel parser MUST reject unmasked client frames.",
      "coverage": {
        "positive": "required",
        "negative": "required",
        "edge": "optional",
        "fuzz": "required"
      },
      "trace": {
