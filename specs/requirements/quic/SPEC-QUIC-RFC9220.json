  "requirements": [
    {
      "id": "REQ-QUIC-RFC9220-0001",
      "title": "Use RFC8441 semantics for Extended CONNECT pseudo-headers and setting",
      "statement": "The semantics of the pseudo-header fields and setting MUST be identical to those in HTTP/2 as defined in RFC8441.",
      "coverage": {
        "positive": "required",
        "negative": "required",
        "edge": "optional",
        "fuzz": "deferred"
      },
      "trace": {
        "upstream_refs": [
          "RFC9220-S3-B2-P2-S1",
          "https://www.rfc-editor.org/rfc/rfc9220.html#section-3"
        ],
        "x_test_refs": [
          "tests/Incursa.Quic.Tests/Http3ExtendedConnectTests.cs::HeaderValidator_ExtendedConnectWebSocket_PreservesRfc8441PseudoHeaders",
          "tests/Incursa.Quic.Tests/Http3ExtendedConnectTests.cs::HeaderValidator_MalformedExtendedConnect_ThrowsMessageError"
        ]
      },
      "notes": [
        "Trimmed to the testable invariant while preserving the RFC8441 dependency."
      ]
    },
    {
      "id": "REQ-QUIC-RFC9220-0002",
      "title": "Set SETTINGS_ENABLE_CONNECT_PROTOCOL to 0x08",
      "statement": "The SETTINGS_ENABLE_CONNECT_PROTOCOL value MUST be 0x08 (decimal 8).",
      "coverage": {
        "positive": "required",
        "negative": "required",
        "edge": "optional",
        "fuzz": "deferred"
      },
      "trace": {
        "upstream_refs": [
          "RFC9220-S3-B2-P2-S3",
          "https://www.rfc-editor.org/rfc/rfc9220.html#section-3"
        ],
        "x_test_refs": [
          "tests/Incursa.Quic.Tests/Http3ExtendedConnectTests.cs::SettingsIdentifier_UsesRegisteredEnableConnectProtocolValue",
          "tests/Incursa.Quic.Tests/Http3ExtendedConnectTests.cs::SettingsWriter_And_Parser_RoundTripEnableConnectProtocol",
          "tests/Incursa.Quic.Tests/Http3ExtendedConnectTests.cs::SettingsParser_RejectsDuplicateEnableConnectProtocol"
        ]
      },
      "notes": [
        "Kept the exact wire value and removed explanatory padding."
      ]
    },
    {
      "id": "REQ-QUIC-RFC9220-0003",
      "title": "Respond to unsupported Extended CONNECT protocols",
      "statement": "If a server advertises support for Extended CONNECT but receives an Extended CONNECT request with an unknown or unsupported \":protocol\" value, the server SHOULD respond with a 501 (Not Implemented) status code.",
      "coverage": {
        "positive": "required",
        "negative": "required",
        "edge": "optional",
        "fuzz": "deferred"
      },
      "trace": {
        "upstream_refs": [
          "RFC9220-S3-B3-P3-S1",
          "https://www.rfc-editor.org/rfc/rfc9220.html#section-3"
        ],
        "x_test_refs": [
          "tests/Incursa.Quic.Tests/Http3ExtendedConnectTests.cs::UnsupportedProtocolResponse_UsesRecommendedNotImplementedStatus",
          "tests/Incursa.Quic.Tests/Http3ExtendedConnectTests.cs::SupportedWebSocketProtocol_DoesNotRequireUnsupportedResponse"
        ]
      },
      "notes": [
        "Preserved the non-normative status code recommendation as written."
      ]
    },
    {
      "id": "REQ-QUIC-RFC9220-0004",
      "title": "Provide optional problem-details information",
      "statement": "A server MAY provide more information via a \"problem details\" response.",
      "coverage": {
