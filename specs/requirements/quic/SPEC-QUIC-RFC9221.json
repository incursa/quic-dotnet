  "title": "QUIC DATAGRAM (RFC 9221)",
  "domain": "quic",
  "capability": "datagram",
  "status": "draft",
  "owner": "quic-maintainers",
  "purpose": "Capture the QUIC DATAGRAM requirements defined by RFC 9221 as canonical spec-trace clauses.",
  "scope": "This specification covers the RFC 9221 transport parameter, DATAGRAM frame encoding, behavior, ACK, congestion, flow-control, and security rules for QUIC DATAGRAM support.",
  "context": "RFC 9221 extends QUIC transport with unreliable application datagrams. These requirements intentionally separate RFC 9221 application DATAGRAM frames from the existing runtime effect named QuicConnectionSendDatagramEffect, which sends UDP datagrams containing QUIC packets.",
  "related_artifacts": [
    "ARC-QUIC-RFC9221-0001",
    "WI-QUIC-RFC9221-0001",
    "VER-QUIC-RFC9221-0001"
  ],
