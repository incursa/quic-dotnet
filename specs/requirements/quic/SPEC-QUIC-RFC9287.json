  "title": "QUIC Greasing the QUIC Bit (RFC 9287)",
  "domain": "quic",
  "capability": "transport",
  "status": "draft",
  "owner": "quic-maintainers",
  "purpose": "Capture the RFC 9287 requirements for the grease_quic_bit transport parameter and negotiated QUIC-bit behavior in QUIC version 1.",
  "scope": "This specification covers the RFC 9287 version 1 grease_quic_bit transport parameter, empty-value validation, and the negotiated QUIC-bit behavior that follows transport-parameter processing. It does not cover the optional token-gated early 0-RTT greasing path or the broader RFC 9368/RFC 9369 versioning family.",
  "context": "RFC 9287 defines a version 1 transport parameter that signals support for clearing the QUIC Bit in packets. The broader versioning-family work remains tracked separately in the gap ledger.",
  "related_artifacts": [
    "ARC-QUIC-RFC9287-0001",
    "WI-QUIC-RFC9287-0001",
    "VER-QUIC-RFC9287-0001"
  ],
  "requirements": [
